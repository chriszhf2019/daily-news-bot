# 每日新闻推送 - 环境变量配置模板
# 复制此文件为 .env 并填入真实密钥

# Tavily 搜索 API (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# DeepSeek AI API (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 微信测试号推送（可选，https://mp.weixin.qq.com/debug/cgi-bin/sandbox）
# WECHAT_APP_ID=wx1234567890
# WECHAT_APP_SECRET=your_secret
# WECHAT_OPENID=your_openid
# WECHAT_TEMPLATE_ID=your_template_id

# 邮件推送（可选）
# EMAIL_SMTP_SERVER=smtp.qq.com
# EMAIL_SMTP_PORT=465
# EMAIL_USERNAME=your_email@qq.com
# EMAIL_PASSWORD=your_auth_code
# EMAIL_TO=receiver@example.com

# Pushplus 备用推送（可选，http://pushplus.hxtrip.com）
# PUSHPLUS_TOKEN=your_token

# Flask 后端配置
FLASK_ENV=development
SECRET_KEY=change-this-in-production
JWT_SECRET_KEY=change-this-in-production
DATABASE_URL=postgresql://user:password@localhost:5432/news_analysis
