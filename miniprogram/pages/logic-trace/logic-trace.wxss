/* 容器 */
.logic-trace-container {
  width: 100%;
  height: 100vh;
  background: linear-gradient(135deg, #0F172A 0%, #1E293B 50%, #0F172A 100%);
  position: relative;
  overflow: hidden;
}

/* 页面转场闪烁层 */
.transition-flash {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  opacity: 0;
  pointer-events: none;
  z-index: 1000;
  transition: opacity 0.3s ease;
}

.transition-flash.flash {
  animation: flashEffect 0.6s ease-out forwards;
}

@keyframes flashEffect {
  0% {
    opacity: 0;
  }
  20% {
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}

/* 星星散开效果 */
.stars-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 999;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.stars-container.stars-explode {
  opacity: 1;
  animation: fadeOut 1s ease-out 0.8s forwards;
}

.star {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #ffffff;
  border-radius: 50%;
  box-shadow: 0 0 8rpx 2rpx rgba(255, 255, 255, 0.8);
  opacity: 0;
  left: 50%;
  top: 50%;
}

.stars-container.stars-explode .star {
  animation: starExplode 1.2s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards;
}

@keyframes starExplode {
  0% {
    transform: translate(-50%, -50%) scale(0);
    opacity: 0;
  }
  20% {
    opacity: 1;
  }
  100% {
    transform: translate(calc(-50% + var(--tx)), calc(-50% + var(--ty))) scale(1);
    opacity: 0;
  }
}

@keyframes fadeOut {
  0% {
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}

/* 顶部导航 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  z-index: 100;
  background: transparent;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.nav-back-icon {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 300;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  margin-right: 64rpx;
  letter-spacing: 1rpx;
}

/* 背景微粒 */
.particles-container {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
}

.particle {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  animation: float 20s infinite ease-in-out;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) translateX(0);
    opacity: 0.3;
  }
  25% {
    transform: translateY(-100rpx) translateX(50rpx);
    opacity: 0.6;
  }
  50% {
    transform: translateY(-200rpx) translateX(-50rpx);
    opacity: 0.4;
  }
  75% {
    transform: translateY(-100rpx) translateX(50rpx);
    opacity: 0.5;
  }
}

/* 背景文字水印 */
.watermark-container {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  pointer-events: none;
  z-index: 1;
  opacity: 0.03;
}

.watermark-text {
  display: block;
  font-size: 120rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 8rpx;
  line-height: 1.2;
}

.watermark-subtext {
  display: block;
  font-size: 48rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 20rpx;
  letter-spacing: 4rpx;
}

/* 关键变量浮窗 */
.variables-panel {
  position: fixed;
  right: 24rpx;
  top: 120rpx;
  width: 200rpx;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 2rpx dashed rgba(251, 191, 36, 0.6);
  border-radius: 24rpx;
  padding: 20rpx;
  z-index: 50;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

.variables-title {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(251, 191, 36, 0.9);
  margin-bottom: 16rpx;
  text-align: center;
}

.variables-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.variable-item {
  background: rgba(251, 191, 36, 0.1);
  border-radius: 12rpx;
  padding: 12rpx;
  transition: all 0.3s ease;
}

.variable-item:active {
  transform: scale(0.95);
  background: rgba(251, 191, 36, 0.2);
}

.variable-name {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
  margin-bottom: 4rpx;
}

.variable-value {
  font-size: 18rpx;
  color: rgba(251, 191, 36, 0.8);
}

/* 逻辑树容器 */
.logic-tree-container {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 24rpx;
  z-index: 10;
}

/* 起源区 */
.origins-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  margin-bottom: 80rpx;
}

.section-label {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

.origins-nodes {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  max-width: 600rpx;
}

.origin-node {
  background: rgba(147, 197, 253, 0.1);
  border: 2rpx solid rgba(147, 197, 253, 0.3);
  border-radius: 20rpx;
  padding: 24rpx;
  animation: springIn 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55) both;
  transition: all 0.3s ease;
}

.origin-node.high-weight {
  transform: scale(1.1);
  border-color: rgba(147, 197, 253, 0.8);
  box-shadow: 0 0 20rpx rgba(147, 197, 253, 0.4);
}

.origin-node.low-weight {
  opacity: 0.7;
}

.origin-node:active {
  transform: scale(0.95);
  background: rgba(147, 197, 253, 0.2);
}

.node-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.node-title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.4;
}

.node-weight {
  font-size: 20rpx;
  color: rgba(147, 197, 253, 0.8);
  font-weight: 500;
}

/* 连线 */
.connection-lines {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin: 20rpx 0;
  width: 100%;
}

.connection-line {
  width: 2rpx;
  height: 80rpx;
  border-radius: 2rpx;
  position: relative;
  overflow: hidden;
}

.connection-line::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 10rpx solid currentColor;
}

/* 流光点 */
.flow-dot {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 6rpx;
  height: 6rpx;
  background: #ffffff;
  border-radius: 50%;
  box-shadow: 0 0 10rpx 4rpx rgba(255, 255, 255, 0.8);
  animation: flowDown 1.5s linear infinite;
}

@keyframes flowDown {
  0% {
    top: 0;
    opacity: 0;
    transform: translateX(-50%) scale(0.5);
  }
  10% {
    opacity: 1;
  }
  90% {
    opacity: 1;
  }
  100% {
    top: 100%;
    opacity: 0;
    transform: translateX(-50%) scale(0.5);
  }
}

/* 中心节点 */
.center-node-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 40rpx 0;
}

.center-node {
  width: 400rpx;
  min-height: 200rpx;
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.3), rgba(139, 92, 246, 0.1));
  border: 3rpx solid rgba(139, 92, 246, 0.5);
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  animation: springIn 0.8s cubic-bezier(0.68, -0.55, 0.265, 1.55) both;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.center-node-title {
  font-size: 36rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.95);
  text-align: center;
  line-height: 1.3;
  margin-bottom: 16rpx;
}

.center-node-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
  line-height: 1.4;
}

/* 影响区 */
.impacts-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  margin-top: 80rpx;
}

.impacts-nodes {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  max-width: 600rpx;
}

.impact-node {
  background: rgba(34, 197, 94, 0.1);
  border: 2rpx solid rgba(34, 197, 94, 0.3);
  border-radius: 20rpx;
  padding: 24rpx;
  animation: springIn 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55) both;
  transition: all 0.3s ease;
}

.impact-node.high-weight {
  transform: scale(1.1);
  border-color: rgba(34, 197, 94, 0.8);
  box-shadow: 0 0 20rpx rgba(34, 197, 94, 0.4);
}

.impact-node.low-weight {
  opacity: 0.7;
}

.impact-node:active {
  transform: scale(0.95);
  background: rgba(34, 197, 94, 0.2);
}

/* 弹簧动画 */
@keyframes springIn {
  0% {
    transform: scale(0.3);
    opacity: 0;
  }
  50% {
    transform: scale(1.1);
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 详情浮层 */
.detail-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.detail-overlay.show {
  opacity: 1;
  visibility: visible;
}

.detail-content {
  width: 100%;
  max-height: 60vh;
  background: linear-gradient(135deg, #1E293B, #0F172A);
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.4);
}

.detail-overlay.show .detail-content {
  transform: translateY(0);
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.95);
  flex: 1;
}

.detail-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
}

.detail-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-description {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.6;
}

.detail-meta {
  display: flex;
  gap: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.detail-weight,
.detail-type {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 500;
}
