/* search.wxss - 全局搜索页面样式 */

page {
  background: linear-gradient(180deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
  min-height: 100vh;
}

.search-page {
  min-height: 100vh;
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx;
  padding-top: calc(env(safe-area-inset-top) + 30rpx);
  background: rgba(15, 12, 41, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  position: sticky;
  top: 0;
  z-index: 100;
}

/* 搜索模式切换 */
.search-mode-toggle {
  display: flex;
  padding: 0 30rpx 24rpx;
  background: rgba(15, 12, 41, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.toggle-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.toggle-tab.active {
  background: rgba(196, 161, 68, 0.2);
  border: 1rpx solid rgba(196, 161, 68, 0.4);
}

.tab-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.tab-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
}

.toggle-tab.active .tab-text {
  color: #c4a144;
}

/* 信源纯净度滑块 */
.source-purity-slider {
  padding: 28rpx 30rpx;
  background: rgba(15, 12, 41, 0.7);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.slider-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.slider-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
}

.slider-value {
  font-size: 22rpx;
  color: #c4a144;
  font-weight: 500;
}

.slider-container {
  position: relative;
  height: 40rpx;
  margin-bottom: 16rpx;
}

.slider-track {
  position: absolute;
  top: 18rpx;
  left: 0;
  right: 0;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 2rpx;
}

.slider-progress {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  background: linear-gradient(90deg, #c4a144, #764ba2);
  border-radius: 2rpx;
  transition: width 0.3s;
}

.slider-handle {
  position: absolute;
  top: 10rpx;
  width: 20rpx;
  height: 20rpx;
  transform: translateX(-50%);
  z-index: 10;
}

.handle-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #c4a144;
  border: 4rpx solid rgba(15, 23, 42, 0.8);
  box-shadow: 0 0 12rpx rgba(196, 161, 68, 0.6);
  transition: all 0.3s;
}

.slider-labels {
  display: flex;
  justify-content: space-between;
  padding: 0 10rpx;
}

.label-item {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 全网搜索动态状态 */
.global-search-status {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 40rpx 30rpx;
  align-items: center;
}

.status-step {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  opacity: 0.5;
  transition: all 0.3s;
}

.status-step.active {
  opacity: 1;
  background: rgba(196, 161, 68, 0.2);
  border: 1rpx solid rgba(196, 161, 68, 0.4);
}

.step-icon {
  font-size: 32rpx;
}

.step-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
}

.status-step.active .step-text {
  color: #c4a144;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
}

.clear-icon {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  font-size: 20rpx;
  color: #fff;
}

.voice-icon {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(196, 161, 68, 0.2);
  border: 1rpx solid rgba(196, 161, 68, 0.4);
  border-radius: 50%;
  font-size: 24rpx;
  color: #c4a144;
  margin-left: 8rpx;
  transition: all 0.3s;
}

.voice-icon:active {
  background: rgba(196, 161, 68, 0.3);
  transform: scale(0.95);
}

.voice-icon.recording {
  animation: pulse 1.5s ease-in-out infinite;
  background: rgba(239, 68, 68, 0.2);
  border: 1rpx solid rgba(239, 68, 68, 0.4);
  color: #ef4444;
}

@keyframes pulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4);
  }
  50% {
    box-shadow: 0 0 0 10rpx rgba(239, 68, 68, 0);
  }
}

.cancel-btn {
  font-size: 28rpx;
  color: #c4a144;
}

/* 搜索历史 */
.search-history {
  padding: 40rpx 30rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.history-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.clear-history {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  transition: all 0.3s;
}

.history-tag:active {
  background: rgba(255, 255, 255, 0.15);
  transform: scale(0.95);
}

.tag-icon {
  font-size: 20rpx;
}

.tag-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 热门搜索 */
.hot-search {
  padding: 40rpx 30rpx;
}

.hot-header {
  margin-bottom: 20rpx;
}

.hot-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.hot-tags {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hot-tag {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  transition: all 0.3s;
}

.hot-tag:active {
  background: rgba(255, 255, 255, 0.15);
  transform: scale(0.98);
}

.tag-rank {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.tag-rank.rank-top {
  background: linear-gradient(135deg, #ff6b6b, #ee5a6f);
  color: #fff;
}

.tag-rank.rank-normal {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.6);
}

/* 搜索结果 */
.search-results {
  padding: 40rpx 30rpx;
}

.result-stats {
  margin-bottom: 20rpx;
}

.stats-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 8rpx;
}

.stats-subtext {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* 逻辑演变时间轴 */
.timeline-section {
  margin-bottom: 30rpx;
  padding: 24rpx;
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(196, 161, 68, 0.3);
  border-radius: 20rpx;
}

.timeline-header {
  margin-bottom: 20rpx;
}

.timeline-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #a8b4ff;
}

.timeline-container {
  position: relative;
  padding-left: 30rpx;
}

.timeline-line {
  position: absolute;
  left: 10rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: linear-gradient(180deg, #c4a144, #764ba2);
}

.timeline-items {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.timeline-item {
  position: relative;
  padding-left: 30rpx;
}

.timeline-dot {
  position: absolute;
  left: -30rpx;
  top: 8rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #c4a144;
  border: 4rpx solid rgba(15, 23, 42, 0.8);
  box-shadow: 0 0 12rpx rgba(196, 161, 68, 0.6);
}

.timeline-content {
  background: rgba(255, 255, 255, 0.05);
  padding: 16rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid #c4a144;
}

.timeline-date {
  display: block;
  font-size: 20rpx;
  color: #a8b4ff;
  margin-bottom: 4rpx;
}

.timeline-event {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.5;
}

/* 加载中 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #c4a144;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 结果列表 */
.result-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.result-card {
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  transition: all 0.3s;
  position: relative;
  overflow: hidden;
}

.result-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, #c4a144, #764ba2);
  transform: scaleX(0);
  transition: transform 0.3s ease;
}

.result-card:active {
  background: rgba(255, 255, 255, 0.12);
  transform: scale(0.98);
}

.result-card:active::before {
  transform: scaleX(1);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.category-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.category-badge.AI {
  background: rgba(139, 92, 246, 0.2);
  color: #c4b5fd;
  border: 1rpx solid rgba(139, 92, 246, 0.3);
}

.category-badge.tech {
  background: rgba(59, 130, 246, 0.2);
  color: #93c5fd;
  border: 1rpx solid rgba(59, 130, 246, 0.3);
}

.category-badge.finance {
  background: rgba(245, 158, 11, 0.2);
  color: #fcd34d;
  border: 1rpx solid rgba(245, 158, 11, 0.3);
}

.category-badge.international {
  background: rgba(16, 185, 129, 0.2);
  color: #6ee7b7;
  border: 1rpx solid rgba(16, 185, 129, 0.3);
}

.category-badge.sports {
  background: rgba(239, 68, 68, 0.2);
  color: #fca5a5;
  border: 1rpx solid rgba(239, 68, 68, 0.3);
}

.impact-score {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.score-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #fbbf24;
}

.score-label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.6);
}

.card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.card-summary {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.7;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.tag-chip {
  padding: 6rpx 12rpx;
  background: rgba(196, 161, 68, 0.2);
  border: 1rpx solid rgba(196, 161, 68, 0.3);
  border-radius: 12rpx;
  font-size: 20rpx;
  color: #a8b4ff;
}

.card-meta {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.meta-item {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 分析标记 */
.analysis-badges {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.analysis-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 18rpx;
  font-weight: 500;
}

.analysis-badge:nth-child(1) {
  background: rgba(196, 161, 68, 0.2);
  color: #d8b4fe;
  border: 1rpx solid rgba(196, 161, 68, 0.3);
}

.analysis-badge:nth-child(2) {
  background: rgba(59, 130, 246, 0.2);
  color: #93c5fd;
  border: 1rpx solid rgba(59, 130, 246, 0.3);
}

.badge-icon {
  font-size: 20rpx;
}

.badge-text {
  font-size: 18rpx;
}

/* 卡片操作按钮 */
.card-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.action-button {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: rgba(196, 161, 68, 0.2);
  border: 1rpx solid rgba(196, 161, 68, 0.4);
  border-radius: 20rpx;
  transition: all 0.3s;
}

.action-button:active {
  background: rgba(196, 161, 68, 0.3);
  transform: scale(0.95);
}

.action-icon {
  font-size: 20rpx;
}

.action-text {
  font-size: 22rpx;
  color: #a8b4ff;
  font-weight: 500;
}

/* 无结果 */
.no-results {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.no-results-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.no-results-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 12rpx;
}

.no-results-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}
