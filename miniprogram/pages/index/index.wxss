    radial-gradient(ellipse at 20% 20%, rgba(120, 100, 255, 0.3) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 80%, rgba(255, 100, 200, 0.2) 0%, transparent 50%);
}

.header-content { position: relative; z-index: 1; text-align: center; margin-bottom: 32rpx; }

.header-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.search-btn {
  width: 68rpx;
