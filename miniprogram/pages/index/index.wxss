}

/* AI语音简报浮条 */
.ai-audio-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: rgba(15, 23, 42, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(102, 126, 234, 0.3);
  z-index: 999;
  transition: all 0.3s ease;
  height: 100rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}

.ai-audio-bar.expanded {
  height: 180rpx;
}

.audio-bar-content {
  display: flex;
  align-items: center;
  width: 100%;
  gap: 20rpx;
}

.audio-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s;
}

.audio-icon:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
}

.play-icon {
  font-size: 32rpx;
}

.audio-info {
  flex: 1;
  min-width: 0;
}

.audio-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 4rpx;
}

.audio-subtitle {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.audio-controls {
  display: flex;
  align-items: center;
  gap: 32rpx;
  flex: 1;
  max-width: 500rpx;
}

.audio-waveform {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  height: 40rpx;
}

.wave-bar {
  width: 8rpx;
  background: linear-gradient(180deg, #667eea, #764ba2);
  border-radius: 4rpx;
  transition: height 0.2s ease;
}

.audio-speed {
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s;
}

.audio-speed:active {
  background: rgba(102, 126, 234, 0.3);
  transform: scale(0.95);
}

/* 页面头部 */
.page-header {
  position: relative;
  padding: 148rpx 32rpx 32rpx;
  background: transparent;
}

.header-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
