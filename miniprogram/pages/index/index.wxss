/* 卡片顶部 */
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 24rpx 12rpx;
}

.top-left { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; flex: 1; }
.news-index { font-size: 28rpx; font-weight: 700; color: var(--primary-blue); }
