/* DebateSection 子组件 */
.debate-section-container { background: rgba(30, 41, 59, 0.15); backdrop-filter: blur(10rpx); -webkit-backdrop-filter: blur(10rpx); border-radius: var(--radius-md); margin-bottom: 16rpx; overflow: hidden; border: 1rpx solid rgba(30, 41, 59, 0.25); }

.debate-section-header { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 16rpx; background: rgba(30, 41, 59, 0.2); border-radius: 12rpx; }

.header-left { display: flex; align-items: center; gap: 8rpx; }
.debate-icon { font-size: 22rpx; }
.debate-title { font-size: 22rpx; font-weight: 600; color: #fbbf24; }

.header-right { display: flex; }
.debate-expand-btn { font-size: 20rpx; color: #fbbf24; padding: 8rpx 16rpx; background: rgba(251, 191, 36, 0.1); border-radius: 8rpx; transition: all 0.2s; }
.debate-expand-btn:active { background: rgba(251, 191, 36, 0.2); transform: scale(0.95); }

/* 核心内容条 */
.debate-core-bar { display: flex; justify-content: space-between; align-items: center; padding: 16rpx; background: rgba(30, 41, 59, 0.1); border-radius: 12rpx; }

.core-bar-left { flex: 1; }
.core-bar-center { flex: 0; }
.core-bar-right { flex: 1; }

.core-text { font-size: 20rpx; font-weight: 600; }
.core-bar-left .core-text { color: #4ade80; }
.core-bar-right .core-text { color: #fb7185; }

.core-vs { font-size: 24rpx; font-weight: 800; color: #6b7280; margin: 0 16rpx; }

/* 展开状态：双栏布局 */
.debate-content-expanded { max-height: 0; overflow: hidden; transition: max-height 0.3s; }
.debate-content-expanded.show { max-height: 800rpx; }

.debate-column { flex: 1; padding: 16rpx; border-radius: 12rpx; }
.debate-column.debate-pro { background: rgba(74, 222, 128, 0.1); margin-right: 8rpx; }
.debate-column.debate-con { background: rgba(251, 113, 133, 0.1); margin-left: 8rpx; }

.debate-column-header { margin-bottom: 12rpx; }
.column-title { font-size: 20rpx; font-weight: 600; margin-bottom: 8rpx; }
.debate-column.debate-pro .column-title { color: #4ade80; }
.debate-column.debate-con .column-title { color: #fb7185; }

.column-progress { display: flex; align-items: center; gap: 8rpx; margin-bottom: 12rpx; }
.progress-bar { height: 6rpx; border-radius: 3rpx; }
.progress-bar.progress-pro { background: linear-gradient(90deg, #4ade80, #22c55e); }
.progress-bar.progress-con { background: linear-gradient(90deg, #fb7185, #f97316); }
.progress-text { font-size: 16rpx; color: rgba(255, 255, 255, 0.6); }

.debate-points { display: flex; flex-direction: column; gap: 8rpx; }
.debate-point { display: flex; align-items: flex-start; gap: 8rpx; }
.point-dot { color: rgba(255, 255, 255, 0.4); }
.point-text { font-size: 20rpx; color: rgba(255, 255, 255, 0.85); line-height: 1.5; }

.debate-verdict { padding: 16rpx; background: rgba(59, 130, 246, 0.1); border-radius: 12rpx; margin-top: 16rpx; }
.verdict-label { font-size: 16rpx; font-weight: 600; color: #3b82f6; margin-bottom: 8rpx; display: block; }
.verdict-text { font-size: 18rpx; color: rgba(255, 255, 255, 0.7); line-height: 1.6; }

/* 相关信息 */
