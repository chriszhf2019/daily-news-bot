/* ==================== P0功能样式 ==================== */

/* 骨架屏 */
.skeleton-screen {
  padding: 20rpx;
}

.skeleton-card {
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.skeleton-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.skeleton-badge {
  width: 80rpx;
  height: 32rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  animation: skeleton-loading 1.5s ease-in-out infinite;
}

.skeleton-circle {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  margin-left: auto;
  animation: skeleton-loading 1.5s ease-in-out infinite;
}

.skeleton-title {
  margin-bottom: 16rpx;
}

.skeleton-line {
  height: 32rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  margin-bottom: 12rpx;
  animation: skeleton-loading 1.5s ease-in-out infinite;
}

.skeleton-line.short {
  width: 60%;
}

.skeleton-cards {
  display: flex;
  gap: 12rpx;
}

.skeleton-mini-card {
  flex: 1;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  animation: skeleton-loading 1.5s ease-in-out infinite;
}

@keyframes skeleton-loading {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

/* 快速操作按钮组 */
.quick-actions-bar {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 0 0;
  margin-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.quick-action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 12rpx 16rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  transition: all 0.3s;
}

.quick-action-btn::after {
  display: none;
}

.quick-action-btn:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.15);
}

.quick-action-btn.favorited {
  background: rgba(255, 71, 87, 0.2);
  border-color: rgba(255, 71, 87, 0.3);
  color: #ff6b81;
}

.quick-action-btn.read-later-active {
  background: rgba(255, 193, 7, 0.2);
  border-color: rgba(255, 193, 7, 0.3);
  color: #ffc107;
}

.quick-action-btn.share-btn {
  background: rgba(102, 126, 234, 0.2);
  border-color: rgba(102, 126, 234, 0.3);
  color: #667eea;
}

.action-icon {
  font-size: 24rpx;
}

.action-text {
  font-size: 20rpx;
}

/* 热门标签 */
.category-item.hot-topic {
  position: relative;
}

.hot-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: linear-gradient(135deg, #ff6b6b, #ff4757);
  border-radius: 16rpx;
  font-size: 18rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 71, 87, 0.4);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.1);
  }
}

/* 关注标签 */
.category-item.my-focus {
  position: relative;
}

.focus-count {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: linear-gradient(135deg, #ffd700, #ffb700);
  border-radius: 16rpx;
  font-size: 18rpx;
  color: #1a1a1a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 215, 0, 0.4);
  animation: glow 2s ease-in-out infinite;
}

@keyframes glow {
  0%, 100% {
    box-shadow: 0 4rpx 12rpx rgba(255, 215, 0, 0.4);
  }
  50% {
    box-shadow: 0 4rpx 20rpx rgba(255, 215, 0, 0.6), 0 0 30rpx rgba(255, 215, 0, 0.3);
  }
}

/* 热门和关注标签激活状态 */
.category-item.hot-topic.active {
  background: linear-gradient(135deg, rgba(255, 71, 87, 0.3), rgba(255, 107, 129, 0.2));
  border-color: rgba(255, 71, 87, 0.4);
}

.category-item.my-focus.active {
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.3), rgba(255, 183, 0, 0.2));
  border-color: rgba(255, 215, 0, 0.4);
}

/* 优化加载更多按钮 */
.load-more-btn {
  position: relative;
  overflow: hidden;
}

.load-more-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s;
}

.load-more-btn:active::before {
  left: 100%;
}

/* 响应式优化 */
@media (max-width: 375px) {
  .quick-action-btn {
    padding: 10rpx 12rpx;
    font-size: 20rpx;
  }
  
  .action-icon {
    font-size: 22rpx;
  }
  
  .action-text {
    font-size: 18rpx;
  }
}



