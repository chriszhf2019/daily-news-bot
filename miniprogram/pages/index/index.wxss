/* 首页 — 极简设计 */
page { background: var(--bg); }

/* 顶部统计栏 */
.stats-bar { display: flex; gap: var(--space-sm); padding: var(--space-md); padding-top: 0; }
.stat-card { flex: 1; background: var(--surface); border-radius: var(--radius); padding: 24rpx; text-align: center; box-shadow: var(--shadow); transition: transform 0.15s; }
.stat-card:active { transform: scale(0.97); }
.stat-card .stat-icon { font-size: 36rpx; margin-bottom: 8rpx; display: block; }
.stat-card .stat-num { font-size: 44rpx; font-weight: 700; display: block; }
.stat-card .stat-label { font-size: 20rpx; color: var(--text-secondary); margin-top: 4rpx; }

/* 分类栏 */
.category-bar { padding: 0 var(--space-md) var(--space-sm); }
.category-scroll { white-space: nowrap; }
.category-list { display: flex; gap: 12rpx; }
.category-item { display: inline-flex; align-items: center; gap: 6rpx; padding: 12rpx 24rpx; border-radius: 24rpx; font-size: 26rpx; background: var(--surface); color: var(--text-secondary); transition: all 0.2s; }
.category-item.active { background: var(--accent-dim); color: var(--accent); }
.category-item .cat-icon { font-size: 28rpx; }
.category-item .cat-name { font-weight: 500; }

/* 模式切换 */
.mode-switcher { display: flex; gap: var(--space-sm); padding: var(--space-sm) var(--space-md); }
.mode-item { flex: 1; text-align: center; padding: 16rpx; border-radius: var(--radius-sm); font-size: 24rpx; background: var(--surface); color: var(--text-secondary); transition: all 0.2s; }
.mode-item.active { background: var(--accent-dim); color: var(--accent); }
.mode-item .mode-icon { font-size: 28rpx; display: block; margin-bottom: 4rpx; }

/* 新闻列表 */
.standard-list, .beginner-list, .digest-list { padding: 0 var(--space-md); }
.standard-card, .beginner-card, .digest-card { background: var(--surface); border-radius: var(--radius); padding: var(--space-md); margin-bottom: var(--space-sm); box-shadow: var(--shadow); animation: fadeUp 0.35s ease both; position: relative; }
.card-title-wrap { margin-bottom: 8rpx; }
.card-title { font-size: 30rpx; font-weight: 600; line-height: 1.4; color: var(--text); display: block; }
.card-subtitle { font-size: 22rpx; color: var(--text-muted); margin-top: 4rpx; }
.card-meta { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; font-size: 20rpx; color: var(--text-muted); }
.card-summary { font-size: 26rpx; color: var(--text-secondary); line-height: 1.6; margin-top: 12rpx; }

/* 追踪 + 第二天标记 */
.tracked-badge { display: inline-block; font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 8rpx; background: var(--accent-dim); color: var(--accent); margin-left: 8rpx; }
.nextday-badge { display: inline-block; font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 8rpx; background: rgba(251,191,36,0.15); color: #fbbf24; margin-left: 8rpx; }

/* 底部操作 */
.card-actions { display: flex; gap: 8rpx; margin-top: 16rpx; padding-top: 12rpx; border-top: 1rpx solid var(--divider); }
.action-btn { display: flex; align-items: center; gap: 4rpx; padding: 8rpx 16rpx; border-radius: 8rpx; font-size: 22rpx; background: var(--bg); color: var(--text-secondary); transition: all 0.15s; }
.action-btn:active { background: var(--surface-hover); }
.action-btn .btn-icon { font-size: 24rpx; }
.action-btn.tracked { background: var(--accent-dim); color: var(--accent); }

/* 空状态 */
.empty-state { text-align: center; padding: 120rpx 0; }
.empty-state .empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-state .empty-title { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.empty-state .empty-desc { font-size: 26rpx; color: var(--text-secondary); }

/* 情绪浮层 */
.sentiment-popup { position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 200; display: flex; align-items: center; justify-content: center; }
.sentiment-popup .popup-content { background: var(--surface); border-radius: var(--radius); padding: var(--space-lg); width: 560rpx; }
.popup-title { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; }
.sentiment-legend { display: flex; gap: 32rpx; margin-top: 16rpx; }
.legend-item { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; }
.legend-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.legend-dot.positive { background: var(--accent); }
.legend-dot.neutral { background: #fbbf24; }
.legend-dot.negative { background: #ef4444; }

/* 重要信号列表 */
.signal-list { margin: var(--space-md); padding: var(--space-md); background: var(--surface); border-radius: var(--radius); }
.signal-item { display: flex; gap: 12rpx; padding: 12rpx 0; border-bottom: 1rpx solid var(--divider); }
.signal-item:last-child { border-bottom: none; }
.signal-score { font-size: 24rpx; font-weight: 700; color: var(--accent); min-width: 40rpx; }
.signal-text { font-size: 26rpx; line-height: 1.5; }
.signal-reason { font-size: 22rpx; color: var(--text-secondary); margin-top: 4rpx; }

/* 加载状态 */
.loading-state { text-align: center; padding: 120rpx 0; }
.loading-spinner { width: 60rpx; height: 60rpx; border: 4rpx solid var(--divider); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 24rpx; }
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: var(--text-secondary); }

/* 追踪弹窗 */
.tracked-news-list { padding: 0 var(--space-md); margin-top: var(--space-sm); }
