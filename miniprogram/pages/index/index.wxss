.category-item.filter-btn .cat-icon,
.category-item.filter-btn .cat-name {
  color: #ffd700;
}

/* 快捷筛选弹窗 */
.quick-filter-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 9999;
  display: flex;
  align-items: flex-end;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.quick-filter-modal.show {
  opacity: 1;
  visibility: visible;
}

.quick-filter-content {
  width: 100%;
  max-height: 80vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  transform: translateY(100%);
  transition: transform 0.3s;
}

.quick-filter-modal.show .quick-filter-content {
  transform: translateY(0);
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: rgba(102, 126, 234, 0.2);
  border-bottom: 1rpx solid rgba(102, 126, 234, 0.3);
}

.filter-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.filter-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  color: #fff;
  font-size: 28rpx;
}

.filter-body {
  padding: 24rpx 30rpx;
  max-height: 55vh;
  overflow-y: auto;
}

.filter-section {
  margin-bottom: 30rpx;
}

.filter-section-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 16rpx;
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 18rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  transition: all 0.3s;
}

.filter-tag.selected {
  background: rgba(102, 126, 234, 0.3);
  border-color: rgba(102, 126, 234, 0.6);
}

.filter-tag-icon {
  font-size: 22rpx;
}

.filter-tag-name {
  font-size: 24rpx;
  color: #fff;
}

.filter-tag-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.filter-action {
  font-size: 24rpx;
  color: var(--primary-light);
  text-decoration: underline;
}

.filter-keyword-input {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.filter-keyword-input .keyword-input {
  flex: 1;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #fff;
}

.keyword-add-btn {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border: none;
  padding: 0;
}

.keyword-add-btn::after { display: none; }

.filter-keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-keyword {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 16rpx;
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.2), rgba(255, 165, 0, 0.2));
  border: 1rpx solid rgba(255, 215, 0, 0.4);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #ffd700;
}

.keyword-remove {
  font-size: 20rpx;
  color: #ffd700;
}

.filter-footer {
  padding: 20rpx 30rpx 40rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.filter-apply-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.filter-apply-btn::after { display: none; }


/* 加载更多按钮 */
.load-more-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
  margin: 0 20rpx 20rpx;
}

.load-more-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  max-width: 500rpx;
  padding: 28rpx 40rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.3), rgba(118, 75, 162, 0.3));
  border: 2rpx solid rgba(102, 126, 234, 0.5);
  border-radius: 50rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s;
}

.load-more-btn::after {
  display: none;
}

.load-more-btn:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.5), rgba(118, 75, 162, 0.5));
}

.load-more-btn.loading {
  opacity: 0.7;
}

.load-more-icon {
  font-size: 32rpx;
}

.load-more-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.load-more-text {
  font-size: 28rpx;
}

.load-more-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* ==================== 三部分结构优化样式 ==================== */

/* 分组容器 */
.section-group {
  margin-bottom: 32rpx;
  background: rgba(30, 58, 138, 0.08);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  border: 1rpx solid rgba(102, 126, 234, 0.15);
  position: relative;
  overflow: hidden;
}

.section-group::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, 
    rgba(102, 126, 234, 0.6) 0%, 
    rgba(118, 75, 162, 0.6) 50%, 
    rgba(102, 126, 234, 0.6) 100%
  );
}

/* 第一部分：情报七要素 */
.intelligence-essentials {
  background: rgba(30, 58, 138, 0.1);
  border-color: rgba(102, 126, 234, 0.2);
}

.intelligence-essentials::before {
  background: linear-gradient(90deg, 
    rgba(102, 126, 234, 0.8) 0%, 
    rgba(59, 130, 246, 0.8) 100%
  );
}

/* 第二部分：相关性分析 */
.relevance-analysis {
  background: rgba(118, 75, 162, 0.08);
  border-color: rgba(168, 85, 247, 0.15);
}

.relevance-analysis::before {
  background: linear-gradient(90deg, 
    rgba(168, 85, 247, 0.8) 0%, 
    rgba(236, 72, 153, 0.8) 100%
  );
}

/* 第三部分：扩展性功能 */
.extended-features {
  background: rgba(16, 185, 129, 0.08);
  border-color: rgba(16, 185, 129, 0.15);
}

.extended-features::before {
  background: linear-gradient(90deg, 
    rgba(16, 185, 129, 0.8) 0%, 
    rgba(5, 150, 105, 0.8) 100%
  );
}

/* 分组头部 */
.group-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.group-icon {
  font-size: 36rpx;
  line-height: 1;
}

.group-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  flex: 1;
  letter-spacing: 1rpx;
}

.group-badge {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

/* 子项描述 */
.section-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-left: 8rpx;
  font-style: italic;
}

/* 快捷操作按钮组 */
.quick-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.quick-actions .action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 16rpx;
  background: rgba(102, 126, 234, 0.15);
  border: 1rpx solid rgba(102, 126, 234, 0.3);
  border-radius: var(--radius-md);
  color: #fff;
  font-size: 24rpx;
  transition: all 0.3s ease;
}

.quick-actions .action-btn:active {
  transform: scale(0.95);
  background: rgba(102, 126, 234, 0.25);
}

.quick-actions .logic-trace-btn {
  background: rgba(168, 85, 247, 0.15);
  border-color: rgba(168, 85, 247, 0.3);
}

.quick-actions .detail-btn {
  background: rgba(16, 185, 129, 0.15);
  border-color: rgba(16, 185, 129, 0.3);
}

/* 优化section-header在分组内的样式 */
.section-group .section-header {
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: var(--radius-md);
  transition: all 0.3s ease;
}

.section-group .section-header:active {
  background: rgba(255, 255, 255, 0.08);
}

/* 优化内容区域的间距 */
.section-group .summary-content,
.section-group .source-content,
.section-group .cross-content,
.section-group .tags-content,
.section-group .ai-interpret-content,
.section-group .predict-content,
.section-group .timeline-content,
.section-group .ripple-content,
.section-group .debate-content,
.section-group .personal-content,
.section-group .related-content {
  margin-top: 12rpx;
  padding: 16rpx;
  background: rgba(0, 0, 0, 0.2);
  border-radius: var(--radius-md);
}

/* 优化predict-inner的样式 */
.predict-inner {
  padding: 20rpx;
}

/* 优化personal-content的样式 */
.personal-content {
  padding: 20rpx;
}

.personal-content.show {
  display: block;
}

/* 优化related-content的样式 */
.related-content {
  padding: 16rpx;
}

.related-content.show {
  display: block;
}

/* 卡片底部操作栏优化 */
.card-footer {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.footer-actions {
  display: flex;
  gap: 12rpx;
  justify-content: space-between;
}

.footer-actions .action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 8rpx;
  background: rgba(102, 126, 234, 0.1);
  border: 1rpx solid rgba(102, 126, 234, 0.2);
  border-radius: var(--radius-md);
  color: #fff;
  font-size: 22rpx;
  transition: all 0.3s ease;
}

.footer-actions .action-btn:active {
  transform: scale(0.95);
  background: rgba(102, 126, 234, 0.2);
}

.footer-actions .action-btn.favorited {
  background: rgba(239, 68, 68, 0.15);
  border-color: rgba(239, 68, 68, 0.3);
}

.footer-actions .btn-icon {
  font-size: 32rpx;
  line-height: 1;
}

.footer-actions .btn-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 响应式优化 */
@media (max-width: 375px) {
  .section-group {
    padding: 20rpx;
  }
  
  .group-header {
    margin-bottom: 16rpx;
  }
  
  .group-title {
    font-size: 28rpx;
  }
  
  .quick-actions .action-btn {
    padding: 16rpx 12rpx;
    font-size: 22rpx;
  }
}

/* 动画优化 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.section-group {
  animation: fadeInUp 0.4s ease-out;
}

.intelligence-essentials {
  animation-delay: 0.1s;
}

.relevance-analysis {
  animation-delay: 0.2s;
}

.extended-features {
  animation-delay: 0.3s;
}

/* 深色模式优化 */
@media (prefers-color-scheme: dark) {
  .section-group {
    background: rgba(30, 58, 138, 0.12);
  }
  
  .group-header {
    border-bottom-color: rgba(255, 255, 255, 0.15);
  }
}

/* ==================== 卡片式布局样式 ==================== */

/* 三大分析卡片容器 */
.analysis-cards {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

/* 分析卡片 */
.analysis-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 16rpx;
  background: rgba(30, 58, 138, 0.15);
  border: 1rpx solid rgba(102, 126, 234, 0.3);
  border-radius: var(--radius-lg);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.analysis-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, rgba(102, 126, 234, 0.8), rgba(59, 130, 246, 0.8));
}

.analysis-card:active {
  transform: scale(0.95);
  background: rgba(30, 58, 138, 0.25);
}

/* 7要素分析卡片 */
.essentials-card::before {
  background: linear-gradient(90deg, #667eea, #3b82f6);
}

/* 相关性分析卡片 */
.relevance-card {
  background: rgba(118, 75, 162, 0.15);
  border-color: rgba(168, 85, 247, 0.3);
}

.relevance-card::before {
  background: linear-gradient(90deg, #a855f7, #ec4899);
}

/* 深度探索卡片 */
.extended-card {
  background: rgba(16, 185, 129, 0.15);
  border-color: rgba(16, 185, 129, 0.3);
}

.extended-card::before {
  background: linear-gradient(90deg, #10b981, #059669);
}

/* 卡片图标 */
.card-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

/* 卡片标题 */
.card-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

/* 卡片箭头 */
.card-arrow {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: bold;
}

/* 情绪指数 */
.sentiment-index {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: rgba(30, 58, 138, 0.1);
  border-radius: var(--radius-lg);
  border: 1rpx solid rgba(102, 126, 234, 0.2);
}

.index-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.index-value-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
}

.index-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #10b981;
  z-index: 2;
}

.index-ring {
  position: absolute;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(16, 185, 129, 0.2);
  border-top-color: #10b981;
  transform: rotate(calc(var(--progress) * 3.6deg));
  z-index: 1;
}

/* ==================== 详情弹窗样式 ==================== */

/* 弹窗遮罩 */
.analysis-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  z-index: 1000;
  display: none;
  align-items: center;
  justify-content: center;
}

.analysis-modal.show {
  display: flex;
}

/* 弹窗内容 */
.modal-content {
  width: 90%;
  max-height: 80vh;
  background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
  border-radius: var(--radius-lg);
  overflow: hidden;
  animation: modalSlideUp 0.3s ease-out;
}

@keyframes modalSlideUp {
  from {
    opacity: 0;
    transform: translateY(100rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 弹窗头部 */
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background: rgba(30, 58, 138, 0.3);
  border-bottom: 1rpx solid rgba(102, 126, 234, 0.3);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.4;
  flex: 1;
  margin: 0 20rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 0.5rpx;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
}

.modal-close:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.9);
}

/* 弹窗主体 */
.modal-body {
  max-height: calc(80vh - 120rpx);
  padding: 32rpx;
}

/* 弹窗章节 */
.modal-section {
  margin-bottom: 32rpx;
}

.modal-section .section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.modal-section .section-content {
  font-size: 26rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.85);
  display: block;
}

/* 信息出处样式 */
.source-info {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 24rpx;
}

.info-label {
  color: rgba(255, 255, 255, 0.6);
  margin-right: 8rpx;
}

.info-value {
  color: rgba(255, 255, 255, 0.9);
}

.reliability-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(102, 126, 234, 0.2);
}

.reliability-badge .rating-stars {
  color: #fbbf24;
  font-size: 20rpx;
}

.reliability-badge .rating-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 多源对证 */
.cross-reference-section {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.subsection-title {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 12rpx;
}

.cross-item {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.cross-source {
  color: rgba(102, 126, 234, 0.9);
  font-weight: 600;
}

.cross-angle {
  color: rgba(255, 255, 255, 0.8);
}

/* 标签列表 */
.modal-section .tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.modal-section .tag-chip {
  padding: 8rpx 16rpx;
  background: rgba(102, 126, 234, 0.2);
  border: 1rpx solid rgba(102, 126, 234, 0.3);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 时间线 */
.modal-section .timeline-list {
  position: relative;
  padding-left: 32rpx;
}

.modal-section .timeline-item {
  position: relative;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
}

.modal-section .timeline-dot {
  position: absolute;
  left: -32rpx;
  top: 8rpx;
  width: 12rpx;
  height: 12rpx;
  background: #3b82f6;
  border-radius: 50%;
}

.modal-section .timeline-dot::before {
  content: '';
  position: absolute;
  left: 5rpx;
  top: 12rpx;
  width: 2rpx;
  height: 40rpx;
  background: rgba(59, 130, 246, 0.3);
}

.modal-section .timeline-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.85);
}

/* 涟漪效应 */
.modal-section .ripple-chain {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}

.modal-section .ripple-item {
  display: flex;
  align-items: center;
}

.modal-section .ripple-arrow {
  color: #a78bfa;
  font-size: 24rpx;
  margin: 0 4rpx;
}

.modal-section .ripple-node {
  background: rgba(139, 92, 246, 0.3);
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
}

.modal-section .ripple-industry {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  color: #c4b5fd;
}

