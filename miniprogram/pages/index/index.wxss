/* ==================== 事件时间轴样式 ==================== */
.timeline-container {
  position: relative;
  padding: 20rpx 0;
}

.timeline-line {
  position: absolute;
  left: 20rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  height: 100%;
  background: linear-gradient(180deg, rgba(168, 85, 247, 0.3) 0%, rgba(168, 85, 247, 0.1) 100%);
}

.timeline-nodes {
  position: relative;
  padding-left: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.timeline-node {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 8rpx rgba(168, 85, 247, 0.5);
}

.timeline-dot.past {
  background: rgba(168, 85, 247, 0.4);
  border: 4rpx solid rgba(168, 85, 247, 0.2);
}

.timeline-dot.current {
  background: linear-gradient(135deg, #A855F7, #7C3AED);
  border: 4rpx solid #A855F7;
  width: 24rpx;
  height: 24rpx;
  box-shadow: 0 0 12rpx rgba(168, 85, 247, 0.8);
}

.timeline-dot.future {
  background: rgba(168, 85, 247, 0.2);
  border: 4rpx dashed rgba(168, 85, 247, 0.3);
}

.timeline-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.timeline-date {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 500;
}

.timeline-event {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
}

.timeline-expand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.expand-text {
  font-size: 22rpx;
