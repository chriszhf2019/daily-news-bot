.section-toggle { font-size: 18rpx; color: rgba(255, 255, 255, 0.6); padding: 8rpx 16rpx; background: rgba(255, 255, 255, 0.1); border-radius: 8rpx; transition: all 0.2s; }
.section-toggle:active { background: rgba(255, 255, 255, 0.2); transform: scale(0.95); }

.section-content { max-height: 0; overflow: hidden; transition: max-height 0.3s; }
.section-content.show { max-height: 800rpx; }

.summary-content { font-size: 24rpx; color: rgba(255, 255, 255, 0.85); line-height: 1.7; }

.source-content { display: flex; flex-direction: column; gap: 12rpx; }
.tags-content { display: flex; flex-wrap: wrap; gap: 8rpx; }
.cross-content { display: flex; flex-direction: column; gap: 8rpx; }
.ai-interpret-content { font-size: 24rpx; color: rgba(255, 255, 255, 0.85); line-height: 1.7; }
.ripple-content { display: flex; flex-direction: column; gap: 8rpx; }
.predict-content { display: flex; flex-direction: column; gap: 12rpx; }
.personal-result { background: rgba(255, 255, 255, 0.08); border-radius: 12rpx; padding: 16rpx; max-height: 0; overflow: hidden; transition: max-height 0.3s; }
.personal-result.show { max-height: 1000rpx; }

/* 摘要 */
.summary-section {
  background: rgba(251, 146, 60, 0.1);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border-radius: var(--radius-md);
  margin-bottom: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(251, 146, 60, 0.2);
}

.section-label { display: flex; align-items: center; gap: 8rpx; padding: 12rpx 16rpx; background: rgba(251, 146, 60, 0.15); border-radius: 12rpx; }

/* 信源 */
.source-section { margin-bottom: 16rpx; }
.source-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.source-info { display: flex; align-items: center; }
.source-label { font-size: 22rpx; color: var(--text-secondary); }
.source-name { font-size: 22rpx; color: var(--primary-light); font-weight: 500; text-decoration: underline; }

.source-rating { display: flex; align-items: center; gap: 6rpx; padding: 4rpx 12rpx; border-radius: 20rpx; }
.source-rating.rating-high { background: rgba(46, 213, 115, 0.2); }
.source-rating.rating-medium { background: rgba(255, 165, 2, 0.2); }
.source-rating.rating-low { background: rgba(255, 71, 87, 0.2); }
.rating-stars { font-size: 18rpx; }
.rating-text { font-size: 18rpx; font-weight: 500; }
.rating-high .rating-text { color: #2ed573; }
.rating-medium .rating-text { color: #ffa502; }
.rating-low .rating-text { color: #ff4757; }

.meta-time { display: flex; align-items: center; }
.time-label { font-size: 22rpx; color: var(--text-secondary); }
.time-value { font-size: 22rpx; color: var(--text-secondary); }

/* 多源对证 */
.cross-reference { background: rgba(102, 126, 234, 0.1); border-radius: var(--radius-md); margin-bottom: 16rpx; overflow: hidden; border: 1rpx solid rgba(102, 126, 234, 0.2); }
.cross-header { display: flex; align-items: center; padding: 12rpx 16rpx; background: rgba(102, 126, 234, 0.2); }
.cross-icon { font-size: 20rpx; margin-right: 8rpx; }
.cross-title { flex: 1; font-size: 22rpx; font-weight: 600; color: #a8b4ff; }
.cross-toggle { font-size: 20rpx; color: var(--primary-light); }
.cross-content { max-height: 0; overflow: hidden; transition: max-height 0.3s; }
.cross-content.show { max-height: 300rpx; }
.cross-item { padding: 10rpx 16rpx; border-bottom: 1rpx solid rgba(102, 126, 234, 0.2); }
.cross-item:last-child { border-bottom: none; }
.cross-source { font-size: 22rpx; font-weight: 600; color: #a8b4ff; }
.cross-angle { font-size: 22rpx; color: rgba(255, 255, 255, 0.8); }

/* 标签 */
.tags-section { margin-bottom: 16rpx; }
.tags-list { display: flex; flex-wrap: wrap; gap: 10rpx; }
.tag-chip-glass { padding: 8rpx 16rpx; background: rgba(139,92,246,0.2); backdrop-filter: blur(10rpx); -webkit-backdrop-filter: blur(10rpx); border: 1rpx solid rgba(139,92,246,0.3); border-radius: 24rpx; font-size: 20rpx; font-weight: 500; color: #c4b5fd; }

/* AI解读 */
.ai-interpret-section { background: rgba(46, 213, 115, 0.15); backdrop-filter: blur(10rpx); -webkit-backdrop-filter: blur(10rpx); border-radius: var(--radius-md); padding: 16rpx 20rpx; margin-bottom: 16rpx; border: 1rpx solid rgba(46, 213, 115, 0.25); }
.ai-interpret-header { display: flex; align-items: center; margin-bottom: 10rpx; }
.ai-interpret-icon { font-size: 22rpx; margin-right: 6rpx; }
.ai-interpret-title { font-size: 24rpx; font-weight: 600; color: #7bed9f; }
.ai-persona-tag { margin-left: auto; font-size: 18rpx; padding: 4rpx 10rpx; background: rgba(102, 126, 234, 0.3); border-radius: 12rpx; color: #a8b4ff; }
.ai-interpret-content { font-size: 24rpx; color: #7bed9f; line-height: 1.7; }

/* 涟漪效应 */
.ripple-section { background: rgba(139, 92, 246, 0.15); backdrop-filter: blur(10rpx); -webkit-backdrop-filter: blur(10rpx); border-radius: var(--radius-md); padding: 16rpx 20rpx; margin-bottom: 16rpx; border: 1rpx solid rgba(139, 92, 246, 0.25); }
.ripple-header { display: flex; align-items: center; margin-bottom: 12rpx; }
.ripple-icon { font-size: 22rpx; margin-right: 6rpx; }
.ripple-title { font-size: 24rpx; font-weight: 600; color: #c4b5fd; }
.ripple-chain { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx; }
.ripple-item { display: flex; align-items: center; }
.ripple-arrow { color: #a78bfa; font-size: 24rpx; margin: 0 4rpx; }
.ripple-node { background: rgba(139, 92, 246, 0.3); padding: 8rpx 14rpx; border-radius: 12rpx; }
.ripple-industry { display: block; font-size: 20rpx; font-weight: 600; color: #c4b5fd; }
.ripple-impact { display: block; font-size: 18rpx; color: #a78bfa; }

/* AI预测 */
.ai-predict-section { display: flex; background: rgba(255, 165, 2, 0.15); backdrop-filter: blur(10rpx); -webkit-backdrop-filter: blur(10rpx); border-radius: var(--radius-md); overflow: hidden; margin-bottom: 16rpx; border: 1rpx solid rgba(255, 165, 2, 0.25); }
.predict-accent { width: 6rpx; background: linear-gradient(180deg, #ffa502, #ff6b6b); }
.predict-content { flex: 1; padding: 16rpx 20rpx; }
.predict-header { display: flex; align-items: center; margin-bottom: 10rpx; }
.predict-icon { font-size: 22rpx; margin-right: 6rpx; }
.predict-title { font-size: 24rpx; font-weight: 600; color: #ffda79; }
.predict-text { font-size: 24rpx; color: #ffda79; line-height: 1.7; }

/* 私人关联 */
.personal-link-section { background: rgba(14, 165, 233, 0.15); backdrop-filter: blur(10rpx); -webkit-backdrop-filter: blur(10rpx); border-radius: var(--radius-md); padding: 16rpx 20rpx; margin-bottom: 16rpx; border: 1rpx solid rgba(14, 165, 233, 0.25); }
.personal-header { display: flex; align-items: center; margin-bottom: 12rpx; }
.personal-icon { font-size: 22rpx; margin-right: 6rpx; }
.personal-title { font-size: 24rpx; font-weight: 600; color: #7dd3fc; }

/* 预设身份标签 */
.preset-roles { display: flex; gap: 12rpx; flex-wrap: wrap; margin-bottom: 16rpx; }
.role-tag { display: flex; align-items: center; gap: 6rpx; padding: 8rpx 16rpx; background: rgba(255, 255, 255, 0.08); border: 1rpx solid rgba(255, 255, 255, 0.15); border-radius: 20rpx; transition: all 0.2s; }
.role-tag.active { background: rgba(125, 211, 252, 0.2); border-color: rgba(125, 211, 252, 0.4); }
.role-icon { font-size: 20rpx; }
.role-name { font-size: 20rpx; color: rgba(255, 255, 255, 0.8); }

/* 智能输入框 */
.personal-input-wrap { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.personal-input { flex: 1; height: 64rpx; background: rgba(255, 255, 255, 0.1); border: 1rpx solid rgba(125, 211, 252, 0.3); border-radius: 12rpx; padding: 0 16rpx; font-size: 24rpx; color: #fff; }
.personal-btn { height: 64rpx; padding: 0 28rpx; background: linear-gradient(135deg, #0ea5e9, #0284c7); color: #fff; border: none; border-radius: 12rpx; font-size: 24rpx; font-weight: 500; position: relative; overflow: hidden; }
.personal-btn.loading { opacity: 0.7; }
.personal-btn::after { display: none; }
.btn-text { font-size: 20rpx; }
.btn-loading { display: flex; align-items: center; }
.loading-spinner { font-size: 20rpx; animation: spin 1s linear infinite; }

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 结果呈现区：私人便签样式 */
.personal-result { background: rgba(255, 255, 255, 0.08); border-radius: 12rpx; padding: 16rpx; max-height: 0; overflow: hidden; transition: max-height 0.3s; }
.personal-result.show { max-height: 1000rpx; }

.result-role { display: flex; align-items: center; margin-bottom: 16rpx; }
.role-label { font-size: 20rpx; color: var(--text-secondary); }
.role-value { font-size: 22rpx; font-weight: 600; color: #7dd3fc; margin-right: 12rpx; }
.role-reset { font-size: 18rpx; color: #38bdf8; text-decoration: underline; }

.result-section { display: flex; align-items: flex-start; gap: 12rpx; margin-bottom: 12rpx; }
.result-icon { font-size: 20rpx; }
.result-label { font-size: 18rpx; color: var(--text-secondary); min-width: 80rpx; }
.result-text { font-size: 20rpx; color: rgba(255, 255, 255, 0.85); line-height: 1.6; flex: 1; }
.result-section.highlight .result-text { color: #fbbf24; font-weight: 500; }

/* 预警时钟 */
.result-timeline { display: flex; align-items: center; gap: 8rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(255, 255, 255, 0.1); }
.timeline-label { font-size: 16rpx; color: var(--text-secondary); }
.timeline-dots { display: flex; gap: 8rpx; }
.timeline-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.2); transition: all 0.2s; }
.timeline-dot.active { background: #7dd3fc; transform: scale(1.2); }

/* 设为默认身份 */
.set-default-role { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(255, 255, 255, 0.1); }
.default-role-btn { display: flex; align-items: center; gap: 8rpx; padding: 10rpx 20rpx; background: rgba(255, 193, 7, 0.15); border: 1rpx solid rgba(255, 193, 7, 0.3); border-radius: 20rpx; font-size: 18rpx; color: rgba(255, 255, 255, 0.8); transition: all 0.2s; }
.default-role-btn:active { background: rgba(255, 193, 7, 0.25); }
.default-role-icon { font-size: 18rpx; }
.default-role-text { font-size: 18rpx; }

/* 辩论席 */
.debate-section { background: rgba(234, 179, 8, 0.15); backdrop-filter: blur(10rpx); -webkit-backdrop-filter: blur(10rpx); border-radius: var(--radius-md); margin-bottom: 16rpx; overflow: hidden; border: 1rpx solid rgba(234, 179, 8, 0.25); }
.debate-header { display: flex; align-items: center; padding: 12rpx 16rpx; background: rgba(234, 179, 8, 0.2); }
.debate-icon { font-size: 20rpx; margin-right: 8rpx; }
.debate-title { flex: 1; font-size: 22rpx; font-weight: 600; color: #fde047; }
.debate-toggle { font-size: 20rpx; color: #facc15; }

/* 默认状态：窄条 */
.debate-bar { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 16rpx; transition: all 0.3s; }
.debate-bar.hidden { display: none; }
.debate-bar-text { font-size: 20rpx; font-weight: 600; }
.debate-bar-text.debate-pro { color: #7bed9f; }
.debate-bar-text.debate-con { color: #ff6b81; }
.debate-vs { font-size: 18rpx; font-weight: 800; color: rgba(255, 255, 255, 0.5); margin: 0 16rpx; }

/* 展开状态：双栏布局 */
.debate-content { max-height: 0; overflow: hidden; transition: max-height 0.3s; }
.debate-content.show { max-height: 800rpx; }

/* 天平指示器 */
.debate-scale { position: relative; height: 80rpx; margin-bottom: 16rpx; }
.scale-track { position: absolute; top: 50%; left: 20rpx; right: 20rpx; height: 2rpx; background: rgba(255, 255, 255, 0.2); }
.scale-indicator { position: absolute; top: 50%; transform: translateY(-50%); width: 60rpx; height: 60rpx; border-radius: 50%; background: linear-gradient(135deg, #7bed9f, #ff6b81); transition: left 0.3s; }
.scale-pointer { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 0; height: 0; border-left: 8rpx solid transparent; border-right: 8rpx solid transparent; border-top: 12rpx solid #fff; }
.scale-badge { position: absolute; top: -20rpx; padding: 4rpx 12rpx; background: rgba(255, 255, 255, 0.9); border-radius: 12rpx; font-size: 16rpx; color: #1f2937; white-space: nowrap; }
.scale-badge.scale-pro { left: 0; }
.scale-badge.scale-con { right: 0; }

/* 双栏布局 */
.debate-column { flex: 1; padding: 16rpx; border-radius: 12rpx; }
.debate-column.debate-pro { background: rgba(46, 213, 115, 0.1); margin-right: 8rpx; }
.debate-column.debate-con { background: rgba(255, 71, 87, 0.1); margin-left: 8rpx; }
.debate-column-header { margin-bottom: 12rpx; }
.column-title { font-size: 20rpx; font-weight: 600; margin-bottom: 8rpx; }
.debate-column.debate-pro .column-title { color: #7bed9f; }
.debate-column.debate-con .column-title { color: #ff6b81; }

.column-progress { display: flex; align-items: center; gap: 8rpx; margin-bottom: 12rpx; }
.progress-bar { height: 6rpx; border-radius: 3rpx; }
.progress-bar.progress-pro { background: linear-gradient(90deg, #7bed9f, #5fa847); }
.progress-bar.progress-con { background: linear-gradient(90deg, #ff6b81, #f97316); }
.progress-text { font-size: 16rpx; color: rgba(255, 255, 255, 0.6); }

.debate-points { display: flex; flex-direction: column; gap: 8rpx; }
.debate-point { display: flex; align-items: flex-start; gap: 8rpx; }
.point-dot { color: rgba(255, 255, 255, 0.4); }
.point-text { font-size: 20rpx; color: rgba(255, 255, 255, 0.85); line-height: 1.5; }

/* 用户投票 */
.debate-vote { margin-top: 16rpx; }
.vote-btn { display: flex; align-items: center; gap: 6rpx; padding: 10rpx 16rpx; background: rgba(255, 255, 255, 0.1); border: 1rpx solid rgba(255, 255, 255, 0.2); border-radius: 20rpx; font-size: 18rpx; color: rgba(255, 255, 255, 0.8); }
.vote-btn.vote-pro { border-color: rgba(123, 237, 159, 0.3); }
.vote-btn.vote-pro:active { background: rgba(123, 237, 159, 0.2); }
.vote-btn.vote-con { border-color: rgba(255, 107, 129, 0.3); }
.vote-btn.vote-con:active { background: rgba(255, 107, 129, 0.2); }
.vote-icon { font-size: 20rpx; }
.vote-text { font-size: 18rpx; }
