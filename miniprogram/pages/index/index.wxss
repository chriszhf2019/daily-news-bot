}

.sentiment-meter.positive { background: #dcfce7; color: #16a34a; }
.sentiment-meter.negative { background: #fee2e2; color: #dc2626; }
.sentiment-meter.neutral { background: #f1f5f9; color: #64748b; }

.sentiment-arrow { font-weight: bold; }
.sentiment-label { font-weight: 500; }

/* 影响力 */
.impact-score { display: flex; flex-direction: column; align-items: center; gap: 2rpx; }
.impact-ring { width: 48rpx; height: 48rpx; border-radius: 50%; position: relative; display: flex; align-items: center; justify-content: center; }
.impact-high .impact-ring { background: conic-gradient(var(--accent-red) calc(var(--progress) * 1%), #fee2e2 0); }
.impact-medium .impact-ring { background: conic-gradient(var(--primary-light) calc(var(--progress) * 1%), #dbeafe 0); }
.impact-low .impact-ring { background: conic-gradient(#94a3b8 calc(var(--progress) * 1%), #f1f5f9 0); }
.ring-value { position: absolute; font-size: 20rpx; font-weight: 700; background: #fff; width: 36rpx; height: 36rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.impact-label { font-size: 16rpx; font-weight: 500; }
.impact-high .impact-label { color: var(--accent-red); }
.impact-medium .impact-label { color: var(--primary-light); }

/* 标题 */
.news-title-row { padding: 0 24rpx 16rpx; }
.news-main-title { font-size: 30rpx; font-weight: 600; color: #ffffff; line-height: 1.5; }

/* 卡片主体 */
.card-body { padding: 0 20rpx 20rpx; }

/* 7要素折叠样式 */
.section-header { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 16rpx; background: rgba(255, 255, 255, 0.05); border-radius: 12rpx; transition: all 0.2s; }
