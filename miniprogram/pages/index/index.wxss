/* ==================== 新闻详情弹窗样式 ==================== */
.detail-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.detail-modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.modal-content {
  position: absolute;
  top: 5%; left: 4%; right: 4%; bottom: 5%;
  background: linear-gradient(180deg, #0F172A 0%, #1E293B 100%);
  border-radius: 32rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  border: 1rpx solid rgba(168, 85, 247, 0.2);
  transform: translateY(30rpx);
  transition: transform 0.3s ease;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.4);
}

.detail-modal.show .modal-content {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.04);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  position: relative;
}

.modal-header::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(168, 85, 247, 0.3), transparent);
}

.modal-icon {
  font-size: 36rpx;
}

.modal-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.4;
}

.modal-close {
  width: 52rpx;
  height: 52rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.modal-close:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

.modal-close text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.modal-body {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

