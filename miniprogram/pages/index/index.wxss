  margin-bottom: 12rpx;
}

.stat-icon {
  font-size: 32rpx;
}

.stat-data {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

/* 趋势指示器 */
.stat-trend {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
  margin-bottom: 8rpx;
}

.stat-trend.up {
  background: rgba(46, 213, 115, 0.2);
  color: #2ed573;
}

.stat-trend.down {
  background: rgba(255, 71, 87, 0.2);
  color: #ff4757;
}

.trend-arrow {
  font-weight: bold;
}

.trend-value {
  font-weight: 600;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
  margin-bottom: 4rpx;
}

.stat-hint {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 4rpx;
}

/* 市场情绪卡片 */
.sentiment-card .sentiment-num {
  transition: color 0.3s;
}

.sentiment-num.cold {
  color: #f59e0b;
}

.sentiment-num.warm {
  color: #fbbf24;
}

.sentiment-num.hot {
  color: #2ed573;
}

.sentiment-bar {
  width: 100%;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 3rpx;
  margin: 8rpx 0 4rpx;
  overflow: hidden;
}

.sentiment-progress {
  height: 100%;
  background: linear-gradient(90deg, #f59e0b, #fbbf24, #2ed573);
  border-radius: 3rpx;
  transition: width 0.5s ease;
}

.sentiment-hint.cold {
  color: #f59e0b;
}

.sentiment-hint.warm {
  color: #fbbf24;
}

.sentiment-hint.hot {
  color: #2ed573;
}

/* 重要信号卡片 */
.signal-card.has-signal .signal-icon-wrap {
  background: rgba(239, 68, 68, 0.3);
}

.signal-icon-wrap.glow {
  animation: signalGlow 2s ease-in-out infinite;
}

@keyframes signalGlow {
  0%, 100% {
    box-shadow: 0 0 10rpx rgba(239, 68, 68, 0.3);
  }
  50% {
    box-shadow: 0 0 25rpx rgba(239, 68, 68, 0.6), 0 0 40rpx rgba(239, 68, 68, 0.3);
  }
}

.signal-num.alert {
  color: #ef4444;
  text-shadow: 0 0 20rpx rgba(239, 68, 68, 0.5);
  animation: signalPulse 1.5s ease-in-out infinite;
}

@keyframes signalPulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.7;
  }
}

.signal-hint {
  color: #ef4444;
  font-weight: 500;
}

/* 市场情绪浮层 */
.sentiment-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.sentiment-popup.show {
  opacity: 1;
  visibility: visible;
}

.popup-content {
  width: 85%;
  max-width: 600rpx;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  border-radius: var(--radius-lg);
  border: 1rpx solid rgba(102, 126, 234, 0.3);
  overflow: hidden;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: rgba(102, 126, 234, 0.2);
  border-bottom: 1rpx solid rgba(102, 126, 234, 0.2);
}

.popup-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.popup-close {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
}

.popup-body {
  padding: 30rpx;
}

.sentiment-chart {
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}

.chart-ring {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: conic-gradient(
    #2ed573 0deg calc(var(--positive, 30) * 3.6deg),
    #fbbf24 calc(var(--positive, 30) * 3.6deg) calc((var(--positive, 30) + var(--neutral, 40)) * 3.6deg),
    #ef4444 calc((var(--positive, 30) + var(--neutral, 40)) * 3.6deg) 360deg
  );
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-center {
  width: 140rpx;
  height: 140rpx;
  background: #1a1a2e;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.center-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.center-label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.6);
}

.sentiment-legend {
  display: flex;
  justify-content: space-around;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-dot.positive {
  background: #2ed573;
}

.legend-dot.neutral {
  background: #fbbf24;
}

.legend-dot.negative {
  background: #ef4444;
}

.legend-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.legend-value {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
}

/* 模式切换 - 毛玻璃效果 */
.mode-switcher {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin: 24rpx 0;
}

.mode-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  background: rgba(255,255,255,0.08);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border-radius: 32rpx;
  border: 1rpx solid rgba(255,255,255,0.15);
  transition: all 0.3s ease;
  min-width: 120rpx;
  justify-content: center;
}

.mode-item.active {
  background: rgba(102, 126, 234, 0.4);
  border-color: rgba(102, 126, 234, 0.6);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.mode-item:active {
  transform: scale(0.98);
}

.mode-icon { font-size: 24rpx; }
.mode-text { font-size: 24rpx; color: #fff; font-weight: 500; }

/* 分类栏 - 毛玻璃效果 */
.category-bar {
  background: rgba(15, 12, 41, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  padding: 16rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.3);
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.category-container {
  display: flex;
  align-items: center;
  width: 100%;
}

.category-scroll {
  flex: 0 0 90%;
  overflow-x: auto;
}

.category-list { 
  display: inline-flex; 
  padding: 0 16rpx; 
  gap: 12rpx; 
}

/* AnalysisEntry 组件样式 */
.analysis-entry {
  flex: 0 0 10%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  background: rgba(168, 85, 247, 0.1);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border-left: 1rpx solid rgba(168, 85, 247, 0.5);
  cursor: pointer;
  transition: all 0.3s ease;
}

.analysis-entry:active {
  background: rgba(168, 85, 247, 0.2);
  transform: scale(0.98);
}

.entry-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
  color: #a855f7;
}

.entry-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #a855f7;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 20rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-md);
  transition: all 0.3s ease;
  min-width: 70rpx;
}

.category-item.active {
  background: linear-gradient(135deg, var(--primary-blue), #4f46e5);
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.category-item:active {
  transform: translateY(-1rpx) scale(0.98);
}

.category-item.active .cat-icon,
.category-item.active .cat-name { color: #fff; }

.cat-icon { font-size: 28rpx; margin-bottom: 2rpx; }
.cat-name { font-size: 20rpx; font-weight: 500; color: rgba(255, 255, 255, 0.8); line-height: 1.2; }

/* 加载 */
.loading-state { display: flex; flex-direction: column; align-items: center; padding: 100rpx; }
.loading-spinner { width: 60rpx; height: 60rpx; border: 4rpx solid rgba(255,255,255,0.2); border-top-color: var(--primary-light); border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { margin-top: 20rpx; font-size: 26rpx; color: var(--text-secondary); }

/* 空状态 */
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 150rpx 40rpx; }
.empty-icon { font-size: 100rpx; margin-bottom: 30rpx; }
.empty-text { font-size: 32rpx; color: var(--text-primary); margin-bottom: 20rpx; font-weight: 500; }
.empty-hint { font-size: 26rpx; color: var(--text-secondary); margin-bottom: 40rpx; text-align: center; line-height: 1.6; }
.retry-btn { background: linear-gradient(135deg, var(--primary-light), var(--primary-dark)); color: #fff; font-size: 28rpx; padding: 20rpx 60rpx; border-radius: 40rpx; border: none; }
.tags-empty-hint { font-size: 24rpx; color: var(--text-tertiary); font-style: italic; }
.jargon-empty { font-size: 24rpx; color: var(--text-tertiary); font-style: italic; padding: 20rpx 0; }

/* 新闻流 */
.news-feed { padding: 20rpx; }

/* 模式切换动画 */
.mode-animation {
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.mode-animation.fade-out {
  opacity: 0;
  transform: translateY(20rpx);
  height: 0;
  overflow: hidden;
}

.mode-animation.fade-in {
  opacity: 1;
  transform: translateY(0);
  height: auto;
  overflow: visible;
}

/* 卡片入场动画 */
.card-enter {
  animation: cardEnter 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  opacity: 0;
  transform: translateY(40rpx);
}

@keyframes cardEnter {
  0% {
    opacity: 0;
    transform: translateY(40rpx);
  }
  70% {
    opacity: 1;
    transform: translateY(-10rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 逻辑树流光动画 */
.logic-line {
  position: relative;
  overflow: hidden;
}

.logic-line::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(102, 126, 234, 0.8), transparent);
  animation: logicFlow 2s infinite linear;
}

@keyframes logicFlow {
  0% {
    left: -100%;
  }
  100% {
    left: 100%;
  }
}

/* 脱水模式列表 */
.digest-mode-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.digest-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
}

.digest-item:hover {
  background-color: rgba(255, 255, 255, 0.05);
}

.digest-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.digest-content {
  flex: 1;
  min-width: 0;
}

.digest-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 44rpx;
  margin-bottom: 8rpx;
  display: block;
}

.digest-summary {
  font-size: 26rpx;
  color: #a3a3a3;
  line-height: 36rpx;
  display: block;
}

.digest-timeline {
  margin-top: 12rpx;
  padding: 8rpx 12rpx;
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 8rpx;
  display: inline-block;
}

.timeline-text {
  font-size: 22rpx;
  color: #8b8b8b;
  line-height: 32rpx;
}

.digest-actions {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.digest-action-btn {
  padding: 8rpx;
  margin-right: 12rpx;
  border-radius: 8rpx;
