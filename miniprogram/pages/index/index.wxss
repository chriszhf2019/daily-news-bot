}

/* 主题配色 - 护眼绿 */
.news-container.eye-green {
  --primary-blue: #1a3a2a;
  --primary-light: #4ade80;
  --bg-dark: #0f1f15;
  --bg-dark-secondary: #1a3a2a;
}

.news-container.eye-green page,
page:has(.news-container.eye-green) {
  background: linear-gradient(180deg, #0f1f15 0%, #1a3a2a 50%, #152a1e 100%);
}

.news-container {
