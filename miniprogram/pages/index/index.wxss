}

.header-date { display: block; font-size: 34rpx; font-weight: 600; color: #fff; margin-bottom: 8rpx; }
.header-title { display: block; font-size: 52rpx; font-weight: 800; color: #fff; letter-spacing: 4rpx; text-shadow: 0 4rpx 20rpx rgba(120, 100, 255, 0.5); margin-bottom: 12rpx; }
.header-subtitle { display: block; font-size: 24rpx; color: rgba(255,255,255,0.7); margin-top: 8rpx; }

/* 统计仪表盘 - 高级毛玻璃效果 */
.today-stats-dashboard {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  background: rgba(10, 20, 60, 0.6);
  backdrop-filter: blur(32rpx);
  -webkit-backdrop-filter: blur(32rpx);
  border: 1rpx solid rgba(102, 126, 234, 0.3);
  border-radius: var(--radius-lg);
  padding: 24rpx 20rpx;
  margin-bottom: 24rpx;
  position: relative;
  box-shadow: 
    0 0 32rpx rgba(102, 126, 234, 0.15),
    inset 0 0 64rpx rgba(102, 126, 234, 0.05);
}

/* 科技感蓝光边框 */
.today-stats-dashboard::before {
  content: '';
  position: absolute;
  top: -1rpx;
  left: -1rpx;
  right: -1rpx;
  bottom: -1rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.5), transparent 50%, rgba(102, 126, 234, 0.3));
  z-index: -1;
  opacity: 0.6;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: var(--radius-md);
