/* 标签弹窗 */
.tag-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  z-index: 1000;
  padding: 20rpx;
  animation: slideUp 0.3s ease-out;
}

.tag-popup-content {
  background: linear-gradient(135deg, #1E293B, #0F172A);
  border-radius: 20rpx 20rpx 0 0;
  padding: 24rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.tag-popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.tag-popup-title {
  font-size: 28rpx;
  font-weight: 700;
