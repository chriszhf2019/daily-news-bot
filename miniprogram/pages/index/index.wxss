/* ==================== 脉冲动画 ==================== */
@keyframes pulse {
  0% {
    transform: scale(1);
    opacity: 1;
    box-shadow: 0 0 0 0 rgba(168, 85, 247, 0);
  }
  50% {
    transform: scale(1.1);
    opacity: 0.8;
    box-shadow: 0 0 12rpx rgba(168, 85, 247, 0.6);
  }
  100% {
    transform: scale(1);
    opacity: 1;
    box-shadow: 0 0 0 0 rgba(168, 85, 247, 0);
  }
}

.pulse-animation {
  animation: pulse 2s ease-in-out infinite;
}

/* ==================== 脱水模式时间轴 ==================== */
.digest-timeline {
  margin-top: 8rpx;
  padding: 8rpx 12rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 8rpx;
  border-left: 2rpx solid rgba(168, 85, 247, 0.2);
}

.timeline-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.5;
}

/* ==================== 箭头动画 ====================
.arrow-animation {
  display: inline-block;
  animation: arrowMove 1.5s ease-in-out infinite;
}

@keyframes arrowMove {
  0%, 100% {
    transform: translateX(0);
  }
  50% {
    transform: translateX(8rpx);
  }
}


