}

.tag-popup-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.tag-popup-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.related-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
}

.related-icon {
  font-size: 24rpx;
}

.related-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.tracking-toggle {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  background: rgba(59, 130, 246, 0.1);
  border-radius: 12rpx;
  margin-top: 16rpx;
}

.tracking-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
}

.tracking-switch {
  width: 48rpx;
  height: 28rpx;
  background: rgba(59, 130, 246, 0.2);
  border-radius: 14rpx;
  position: relative;
}

.tracking-switch::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 20rpx;
  height: 20rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 10rpx;
  transition: all 0.3s ease;
}

.tracking-switch.active::before {
  left: 24rpx;
  background: #3B82F6;
}

@keyframes slideUp {
  0% {
    transform: translateY(100%);
    opacity: 0;
  }
  100% {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.6;
    transform: scale(1.1);
  }
}

@keyframes fadeInUp {
  0% {
    transform: translateY(20rpx);
    opacity: 0;
  }
  100% {
    transform: translateY(0);
    opacity: 1;
  }
}

