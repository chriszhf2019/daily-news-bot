/* 新闻简报首页样式 - 顶级版 */

page {
  --primary-blue: #1e3a8a;
  --primary-light: #667eea;
  --accent-green: #2ed573;
  --accent-orange: #ffa502;
  --accent-red: #ff4757;
  --bg-dark: #0f0c29;
  --bg-dark-secondary: #302b63;
  --text-primary: #ffffff;
  --text-secondary: rgba(255, 255, 255, 0.8);
  --text-tertiary: rgba(255, 255, 255, 0.6);
  --radius-lg: 24rpx;
  --radius-md: 16rpx;
  background: linear-gradient(180deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

/* ==================== 小白模式样式重构 ==================== */

/* 弹窗背景 */
.detail-modal.beginner-mode {
  background: rgba(15, 23, 42, 0.85);
}

/* 弹窗内容区 */
.modal-content.beginner-content {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  max-height: 85vh;
}

/* 弹窗头部 */
.modal-header.beginner-header {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  border-bottom: none;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 24rpx;
}

.modal-header.beginner-header .modal-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.modal-header.beginner-header .modal-title {
  color: #78350F;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  flex: 1;
}

.modal-header.beginner-header .modal-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F59E0B;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.4);
}

.modal-header.beginner-header .modal-close:active {
  background: #D97706;
  transform: scale(0.95);
}

/* 弹窗主体 */
.modal-body.beginner-body {
  background: #F8FAFC;
  padding: 24rpx;
  color: #1E293B;
  font-size: 28rpx;
  line-height: 1.7;
}

/* ==================== 形象比喻卡片 ==================== */
.beginner-analogy-card {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%) !important;
  border: none !important;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  padding: 0 !important;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(251, 191, 36, 0.25);
}

.beginner-analogy-card .element-header {
  background: rgba(120, 53, 15, 0.1);
  padding: 20rpx 24rpx;
  margin: 0;
  border-bottom: 1rpx solid rgba(120, 53, 15, 0.1);
}

.beginner-analogy-card .element-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: #F59E0B;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 12rpx;
}

.beginner-analogy-card .element-name {
  color: #78350F;
  font-size: 26rpx;
  font-weight: 600;
}

.beginner-analogy-card .element-content {
  padding: 24rpx;
}

.beginner-analogy-card .analogy-content {
  font-size: 28rpx !important;
  line-height: 1.8 !important;
  color: #78350F !important;
  font-weight: 500;
  text-shadow: none;
}

/* ==================== 故事线时间轴卡片 ==================== */
.beginner-storyline-card {
  background: #FFFFFF !important;
  border: none !important;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  padding: 0 !important;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(139, 92, 246, 0.15);
}

.beginner-storyline-card .element-header {
  background: linear-gradient(135deg, #EDE9FE 0%, #DDD6FE 100%);
  padding: 20rpx 24rpx;
  margin: 0;
  border-bottom: none;
}

.beginner-storyline-card .element-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: #8B5CF6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 12rpx;
}

.beginner-storyline-card .element-name {
  color: #5B21B6;
  font-size: 26rpx;
  font-weight: 600;
}

/* 故事线时间轴 */
.storyline-timeline {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  background: #FAFAFA;
  gap: 0;
}

.storyline-node {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  position: relative;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border-left: 4rpx solid transparent;
}

.storyline-node:nth-child(1) {
  border-left-color: #94A3B8;
}

.storyline-node:nth-child(3) {
  border-left-color: #8B5CF6;
}

.storyline-node:nth-child(5) {
  border-left-color: #10B981;
}

.storyline-connector {
  width: 4rpx;
  height: 24rpx;
  background: linear-gradient(180deg, #CBD5E1, #8B5CF6);
  margin-left: 40rpx;
}

.node-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #F1F5F9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  flex-shrink: 0;
}

.node-label {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-bottom: 8rpx;
}

.storyline-node:nth-child(1) .node-label {
  background: #F1F5F9;
  color: #64748B;
}

.storyline-node:nth-child(3) .node-label {
  background: #EDE9FE;
  color: #7C3AED;
}

.storyline-node:nth-child(5) .node-label {
  background: #D1FAE5;
  color: #059669;
}

.node-content {
  font-size: 26rpx;
  line-height: 1.6;
  color: #334155;
  flex: 1;
  display: block;
}

/* ==================== 其他小白模式卡片通用样式 ==================== */
.element-card.highlight-yellow,
.element-card.highlight-blue,
.element-card.highlight-purple,
.element-card.highlight-green {
  border: none !important;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.element-card .element-header {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  margin: 0;
}

.element-card .element-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.element-card .element-name {
  font-size: 26rpx;
  font-weight: 600;
}

.element-card .element-content {
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #334155;
}

.impact-item {
  font-size: 24rpx;
  line-height: 1.6;
  color: #451a03;
}

.impact-verdict {
  display: block;
  margin-top: 20rpx;
  padding: 16rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #065F46;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 小白模式：社交金句/谈资 */
.beginner-talking-card {
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.talking-points-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #FEF3C7, #FFFBEB);
}

.talking-point-item {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  cursor: pointer;
  transition: all 0.3s;
  border-left: 4rpx solid #F59E0B;
}

.talking-point-item:active {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.talking-point-content {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #451a03;
  margin-bottom: 8rpx;
}

.talking-point-hint {
  display: block;
  font-size: 20rpx;
  color: #92400E;
  font-style: italic;
}

/* 小白模式：追问 AI 导师 */
.beginner-tutor-card {
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.tutor-chat {
  padding: 24rpx;
  background: linear-gradient(135deg, #DBEAFE, #EFF6FF);
}

.tutor-message {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.tutor-avatar {
  font-size: 32rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.tutor-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #451a03;
  flex: 1;
}

.tutor-questions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tutor-question-item {
  padding: 16rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  border-left: 4rpx solid #3B82F6;
  cursor: pointer;
  transition: all 0.3s;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.tutor-question-item:active {
  background: #EFF6FF;
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.tutor-answer {
  padding: 16rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  animation: answerFadeIn 0.3s ease-out;
}

.answer-content {
  font-size: 24rpx;
  line-height: 1.6;
  color: #451a03;
}

@keyframes answerFadeIn {
  0% {
    opacity: 0;
    transform: translateY(10rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 标准模式：七要素分析样式 */
.standard-card {
  background: #111827;
  border: 1rpx solid rgba(102, 126, 234, 0.3);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
  position: relative;
  overflow: hidden;
}

.standard-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, #667eea, #764ba2);
}

.standard-card .element-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.standard-card .element-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.standard-card .element-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  flex: 1;
}

/* 多源验证样式 */
.source-matrix {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.source-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  transition: all 0.3s;
}

.source-item:active {
  background: rgba(102, 126, 234, 0.1);
  transform: translateY(-2rpx);
}

.source-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.source-info {
  flex: 1;
}

.source-name {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 4rpx;
}

.source-status {
  display: block;
  font-size: 20rpx;
  font-weight: 500;
}

.source-status.confirmed {
  color: #2ed573;
}

.source-status.official {
  color: #3b82f6;
}

.ai-verification-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  background: rgba(102, 126, 234, 0.1);
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  border-left: 4rpx solid #667eea;
}

.ai-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.ai-text {
  font-size: 22rpx;
  line-height: 1.6;
  color: #a8b4ff;
  flex: 1;
}

.consensus-section {
  margin-top: 16rpx;
}

.consensus-title {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #2ed573;
  margin-bottom: 12rpx;
}

.consensus-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-left: 20rpx;
}

.consensus-item {
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.8);
}

/* 全景时间轴样式 */
.deep-timeline {
  display: flex;
  flex-direction: column;
  gap: 0;
  position: relative;
}

.timeline-node {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 0;
  position: relative;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 4rpx;
  position: relative;
}

.timeline-dot.origin {
  background: #667eea;
  box-shadow: 0 0 12rpx rgba(102, 126, 234, 0.6);
}

.timeline-dot.current {
  background: #a855f7;
  box-shadow: 0 0 16rpx rgba(168, 85, 247, 0.8);
  animation: pulse 2s ease-in-out infinite;
}

.timeline-dot.future {
  background: rgba(168, 85, 247, 0.4);
  border: 2rpx dashed #a855f7;
}

.timeline-connector {
  width: 4rpx;
  height: 40rpx;
  background: linear-gradient(180deg, rgba(102, 126, 234, 0.6), rgba(168, 85, 247, 0.4));
  align-self: center;
  margin: 0;
}

.timeline-content {
  flex: 1;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  padding: 16rpx;
  transition: all 0.3s;
}

.timeline-content:active {
  background: rgba(102, 126, 234, 0.1);
  transform: translateY(-2rpx);
}

.timeline-stage {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  color: #a8b4ff;
  margin-bottom: 4rpx;
}

.timeline-time {
  display: block;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 8rpx;
}

.timeline-event {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.8);
}

/* 信息博弈样式 */
.game-container {
  display: flex;
  gap: 20rpx;
}

.game-side {
  flex: 1;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  padding: 20rpx;
  transition: all 0.3s;
}

.game-side.consensus {
  border-left: 4rpx solid #2ed573;
}

.game-side.conflict {
  border-left: 4rpx solid #f59e0b;
}

.game-side:active {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.game-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.game-side.consensus .game-label {
  color: #2ed573;
}

.game-side.conflict .game-label {
  color: #f59e0b;
}

.game-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-left: 16rpx;
}

.game-item {
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.8);
}

/* 核心关联主体样式 */
.stakeholders-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.stakeholder-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  transition: all 0.3s;
}

.stakeholder-item:active {
  background: rgba(102, 126, 234, 0.1);
  transform: translateY(-2rpx);
}

.stakeholder-entity {
  font-size: 24rpx;
  font-weight: 600;
  color: #a8b4ff;
  min-width: 120rpx;
}

.stakeholder-action {
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.8);
  flex: 1;
}

/* 底层基石/背景样式 */
.background-content {
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(102, 126, 234, 0.1);
  border-radius: 12rpx;
  padding: 20rpx;
  border-left: 4rpx solid #667eea;
}

/* 次生涟漪效应样式 */
.ripple-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-left: 20rpx;
}

.ripple-item {
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.8);
  padding: 12rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 8rpx;
  transition: all 0.3s;
}

.ripple-item:active {
  background: rgba(102, 126, 234, 0.1);
  transform: translateX(4rpx);
}

/* 情报风险等级样式 */
.risk-container {
  display: flex;
  gap: 20rpx;
}

.risk-item {
  flex: 1;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  transition: all 0.3s;
}

.risk-item:active {
  background: rgba(102, 126, 234, 0.1);
  transform: translateY(-2rpx);
}

.risk-label {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 12rpx;
}

.risk-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #a8b4ff;
}

.risk-value.low {
  color: #2ed573;
}

.risk-value.medium {
  color: #f59e0b;
}

.risk-value.high {
  color: #ef4444;
}

@keyframes pulse {
  0%, 100% {
    box-shadow: 0 0 16rpx rgba(168, 85, 247, 0.8);
  }
  50% {
    box-shadow: 0 0 24rpx rgba(168, 85, 247, 1);
  }
}

/* 小白模式：底部情绪指数 */
.modal-footer.beginner-footer {
  background: #FEF3C7;
  border-top: 1rpx solid #FBBF24;
  padding: 20rpx;
}

.modal-footer.beginner-footer .footer-label {
  color: #451a03;
  font-size: 22rpx;
  font-weight: 600;
}

.modal-footer.beginner-footer .footer-value {
  color: #92400E;
  font-size: 32rpx;
  font-weight: 700;
}

/* 底部关闭按钮 */
.modal-bottom-actions {
  display: flex;
  justify-content: center;
  padding: 30rpx 20rpx;
}

.close-button {
  width: 200rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
}

.close-button:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.4);
}

/* 小白模式底部关闭按钮 */
.beginner-close-button {
  background: linear-gradient(135deg, #FBBF24, #F59E0B);
  color: #92400E;
  box-shadow: 0 4rpx 16rpx rgba(245, 158, 11, 0.3);
}

.beginner-close-button:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.4);
}

/* 小白模式：知识小百科 */
.jargon-explain-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.jargon-explain-item {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 16rpx;
  border-left: 4rpx solid #FBBF24;
  cursor: pointer;
  transition: all 0.3s;
}

.jargon-explain-item:active {
  background: #FEF3C7;
  transform: translateY(-2rpx);
}

.explain-term {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #92400E;
  margin-bottom: 8rpx;
}

.jargon-term {
  border-bottom: 2rpx dashed #F59E0B;
  cursor: pointer;
