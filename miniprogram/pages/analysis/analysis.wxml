<!--pages/analysis/analysis.wxml-->
<!-- AI 情报中心 - 宏观决策看板 -->
<view class="intelligence-center">
  
  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载情报数据中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{!hasData}}">
    <view class="empty-icon">🌐</view>
    <text class="empty-title">暂无情报数据</text>
    <text class="empty-desc">点击下方按钮，AI将为您生成最新的全球情报分析</text>
    <button class="refresh-btn-large" bindtap="refreshIntelligenceData" disabled="{{refreshing}}">
      <text class="btn-icon">{{refreshing ? '⏳' : '🔄'}}</text>
      <text class="btn-text">{{refreshing ? 'AI生成中...' : '生成情报'}}</text>
    </button>
  </view>

  <!-- 有数据时显示内容 -->
  <block wx:else>
    <!-- 顶部情报图谱 Dashboard -->
    <view class="intelligence-dashboard">
      <view class="dashboard-bg"></view>
      
      <!-- 标题和刷新按钮 -->
      <view class="dashboard-header">
        <view class="header-left">
          <text class="dashboard-title">🌐 全球情报中心</text>
          <text class="dashboard-subtitle">{{currentDate}}</text>
          <text class="dashboard-subtitle-secondary">宏观决策 · 关联分析 · AI 交互</text>
        </view>
        <view class="header-right">
          <button class="refresh-btn" bindtap="refreshIntelligenceData" disabled="{{refreshing}}">
            <text class="refresh-icon {{refreshing ? 'spinning' : ''}}">🔄</text>
            <text class="refresh-text">{{refreshing ? '生成中' : '刷新'}}</text>
          </button>
        </view>
      </view>
      
      <!-- 上次刷新时间 -->
      <view class="last-refresh" wx:if="{{lastRefreshTime}}">
        <text class="refresh-time-text">上次更新：{{lastRefreshTime}}</text>
      </view>
      
      <!-- 5 大核心指标 -->
      <view class="core-metrics">
        <view class="metric-card">
          <text class="metric-icon">📈</text>
          <text class="metric-value">{{dash.optimism.score}}%</text>
          <text class="metric-label">市场乐观度</text>
          <view class="metric-bar">
            <view class="metric-fill" style="width: {{dash.optimism.score}}%"></view>
          </view>
        </view>
        <view class="metric-card">
          <text class="metric-icon">📜</text>
          <text class="metric-value">{{dash.policy_sensitivity}}%</text>
          <text class="metric-label">政策敏感度</text>
          <view class="metric-bar">
            <view class="metric-fill policy" style="width: {{dash.policy_sensitivity}}%"></view>
          </view>
        </view>
        <view class="metric-card">
          <text class="metric-icon">💥</text>
          <text class="metric-value">{{dash.tech_breakthrough}}%</text>
          <text class="metric-label">技术突破点</text>
          <view class="metric-bar">
            <view class="metric-fill tech" style="width: {{dash.tech_breakthrough}}%"></view>
          </view>
        </view>
      </view>

      <!-- 情绪构成 + 来源分布 -->
      <view class="sentiment-detail">
        <text class="detail-label">情绪构成</text>
        <view class="sentiment-bars">
          <view class="s-bar"><view class="s-fill positive" style="width:{{dash.optimism.positive*2}}rpx"></view><text>😊 {{dash.optimism.positive}}</text></view>
          <view class="s-bar"><view class="s-fill neutral" style="width:{{dash.optimism.neutral*2}}rpx"></view><text>😐 {{dash.optimism.neutral}}</text></view>
          <view class="s-bar"><view class="s-fill negative" style="width:{{dash.optimism.negative*2}}rpx"></view><text>😟 {{dash.optimism.negative}}</text></view>
        </view>
      </view>

      <!-- 情报产出密度 — 来源分布 -->
      <view class="density-section">
        <text class="detail-label">全球情报产出密度 (Top 10 来源)</text>
        <view class="source-list">
          <view class="source-item" wx:for="{{dash.source_density}}" wx:key="source">
            <text class="source-name">{{item.source}}</text>
            <view class="source-bar-wrap"><view class="source-bar" style="width:{{item.count * 2}}rpx"></view></view>
            <text class="source-count">{{item.count}}</text>
          </view>
        </view>
      </view>

      <!-- 24h 热力图 -->
      <view class="heatmap-section">
        <text class="detail-label">24h AI 情绪热力图</text>
        <view class="heatmap-grid">
          <view class="heatmap-cell" wx:for="{{dash.heatmap}}" wx:key="hour"
                style="background: {{item.count > 5 ? '#22C55E' : item.count > 2 ? '#FBBF24' : '#374151'}}; height: {{item.count * 8 + 16}}rpx">
            <text class="cell-text">{{item.hour}}h</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 新闻总数 -->
    <view class="stats-footer">
      <text class="stats-text">总计 {{dash.total_news}} 条新闻 · 实时数据</text>
    </view>
            </view>
          </view>
          <view class="topic-content">
            <text class="topic-insight">{{item.insight}}</text>
            <view class="topic-stats">
              <text class="stat-item">📰 含 {{item.news_ids.length}} 篇关联情报</text>
            </view>
            <view class="topic-logic">
              <text class="logic-label">核心逻辑链：</text>
              <view class="logic-steps">
                <view class="logic-step" wx:for="{{item.logic_chain}}" wx:key="index">
                  <text class="step-arrow" wx:if="{{index > 0}}">→</text>
                  <text class="step-text">{{item}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- AI 战略顾问 -->
    <view class="ai-advisor-section">
      <view class="advisor-card">
        <view class="advisor-header">
          <text class="advisor-icon">🤖</text>
          <text class="advisor-title">AI 战略顾问</text>
          <text class="advisor-subtitle">基于全球情报的智能分析</text>
        </view>
        <view class="advisor-content">
          <view class="prompt-suggestions">
            <view class="suggestion-item" wx:for="{{advisorPrompts}}" wx:key="index" bindtap="askAdvisor" data-prompt="{{item}}">
              <text class="suggestion-icon">💡</text>
              <text class="suggestion-text">{{item}}</text>
            </view>
          </view>
          <view class="advisor-input">
            <input class="input-field" placeholder="输入你的问题..." value="{{advisorInput}}" bindinput="onAdvisorInput" bindconfirm="askAdvisor"/>
            <button class="send-btn" bindtap="askAdvisor">
              <text class="send-icon">🚀</text>
            </button>
          </view>
        </view>
      </view>
    </view>

    <!-- 明天点名 -->
    <view class="watchlist-section" wx:if="{{insightHub.tomorrow_watch.length > 0}}">
      <view class="section-header">
        <text class="section-title">🔮 明天点名</text>
        <text class="section-subtitle">AI 预测的关键事件</text>
      </view>
      <view class="watchlist-cards">
        <view class="watchlist-card" wx:for="{{insightHub.tomorrow_watch}}" wx:key="event">
          <view class="watchlist-header">
            <text class="event-title">{{item.event}}</text>
            <view class="probability-badge" style="background: {{item.probability > 70 ? '#4ade80' : item.probability > 40 ? '#fbbf24' : '#fb7185'}}">
              <text class="probability-value">{{item.probability}}%</text>
            </view>
          </view>
          <text class="event-reason">{{item.reason}}</text>
          <button class="track-btn" bindtap="trackEvent" data-event="{{item.event}}">
            <text class="track-icon">🔔</text>
            <text class="track-text">追踪</text>
          </button>
        </view>
      </view>
    </view>

    <!-- 今日盲区补全 -->
    <view class="blindspot-section" wx:if="{{insightHub.blind_spot}}">
      <view class="blindspot-card">
        <view class="blindspot-header">
          <text class="blindspot-icon">⚡</text>
          <text class="blindspot-title">今日盲区补全</text>
          <text class="blindspot-subtitle">跳出信息茧房</text>
        </view>
        <view class="blindspot-content">
          <text class="blindspot-message">{{insightHub.blind_spot.message}}</text>
          <view class="blindspot-news" bindtap="openBlindspotNews" data-news-id="{{insightHub.blind_spot.news_id}}">
            <text class="news-title">{{insightHub.blind_spot.title}}</text>
            <text class="news-reason">{{insightHub.blind_spot.reason}}</text>
          </view>
          <button class="read-btn" bindtap="openBlindspotNews" data-news-id="{{insightHub.blind_spot.news_id}}">
            <text class="read-icon">📖</text>
            <text class="read-text">强制阅读</text>
          </button>
        </view>
      </view>
    </view>
  </block>

  <!-- 底部安全区域 -->
  <view class="safe-bottom"></view>
</view>
