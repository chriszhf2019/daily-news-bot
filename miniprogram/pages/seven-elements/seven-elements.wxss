/* seven-elements.wxss - 七要素审计页面（极简版） */

/* 全局 */
.audit-page {
  min-height: 100vh;
  background: #0F172A;
  color: #E2E8F0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 24rpx;
}

/* 加载状态 */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid rgba(139, 92, 246, 0.2);
  border-top-color: #8B5CF6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-tip {
  margin-top: 24rpx;
  color: rgba(255,255,255,0.6);
}

/* 空状态 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  padding: 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-tip {
  color: rgba(255,255,255,0.5);
  margin-bottom: 32rpx;
}

.empty-box .back-btn {
  padding: 20rpx 48rpx;
  background: #8B5CF6;
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
}

/* 顶部 */
.page-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx 20rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.08);
}

.page-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.status-tag {
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-family: 'SF Mono', Monaco, monospace;
}

.status-tag.success {
  background: rgba(16, 185, 129, 0.15);
  color: #10B981;
}

.status-tag.warn {
  background: rgba(245, 158, 11, 0.15);
  color: #F59E0B;
}

/* 新闻标题 */
.news-box {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
}

.news-cat {
  font-size: 22rpx;
  color: #8B5CF6;
  font-weight: 600;
  margin-right: 12rpx;
}

.news-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.5;
}

/* 滚动区 */
.content-scroll {
  height: calc(100vh - 280rpx);
  padding: 0 28rpx;
}

/* 审计模块 */
.audit-section {
  margin-top: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
}

.section-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.section-num {
  font-size: 22rpx;
  font-weight: 700;
  color: #8B5CF6;
  font-family: 'SF Mono', Monaco, monospace;
}

.section-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  flex: 1;
}

.score-tag {
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  font-family: 'SF Mono', Monaco, monospace;
}

.score-tag.high {
  background: rgba(16, 185, 129, 0.15);
  color: #10B981;
}

.score-tag.mid {
  background: rgba(251, 191, 36, 0.15);
  color: #FBBF24;
}

.score-tag.low {
  background: rgba(239, 68, 68, 0.15);
  color: #EF4444;
}

.section-body {
  padding-left: 8rpx;
}

.empty-line {
  color: rgba(255,255,255,0.3);
  font-size: 22rpx;
}

/* 01 证据链 */
.fact-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.fact-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.fact-icon {
  color: #10B981;
  font-weight: 700;
  width: 28rpx;
  flex-shrink: 0;
}

.fact-text {
  flex: 1;
  line-height: 1.5;
  color: #E2E8F0;
}

.conflict-box {
  margin-top: 16rpx;
  padding: 16rpx;
  background: rgba(245, 158, 11, 0.08);
  border-left: 3rpx solid #F59E0B;
  border-radius: 0 8rpx 8rpx 0;
}

.conflict-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #F59E0B;
  display: block;
  margin-bottom: 10rpx;
}

.conflict-row {
  margin-top: 8rpx;
}

.conflict-text {
  color: rgba(255,255,255,0.7);
  line-height: 1.5;
}

.verdict-line {
  margin-top: 16rpx;
  font-style: italic;
  color: rgba(255,255,255,0.5);
  font-size: 22rpx;
}

/* 02 共识冲突 */
.compare-box {
  display: flex;
  gap: 16rpx;
}

.compare-col {
  flex: 1;
  padding: 16rpx;
  border-radius: 8rpx;
}

.consensus-col {
  background: rgba(16, 185, 129, 0.06);
  border: 1rpx solid rgba(16, 185, 129, 0.15);
}

.gap-col {
  background: rgba(239, 68, 68, 0.06);
  border: 1rpx solid rgba(239, 68, 68, 0.15);
}

.col-title {
  font-size: 22rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}

.consensus-col .col-title {
  color: #10B981;
}

.gap-col .col-title {
  color: #EF4444;
}

.col-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.col-item {
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255,255,255,0.8);
}

/* 03 原子事实表格 */
.data-table {
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 8rpx;
  overflow: hidden;
}

.table-row {
  display: flex;
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
}

.table-row:last-child {
  border-bottom: none;
}

.table-header {
  background: rgba(139, 92, 246, 0.1);
}

.table-header .table-cell {
  font-weight: 600;
  color: #A78BFA;
}

.table-cell {
  padding: 14rpx 12rpx;
  font-size: 22rpx;
  font-family: 'SF Mono', Monaco, monospace;
}

.cell-key {
  flex: 2;
  color: rgba(255,255,255,0.7);
}

.cell-val {
  flex: 3;
  color: #E2E8F0;
}

.cell-status {
  flex: 1.5;
  text-align: center;
}

.cell-status.verified {
  color: #10B981;
}

.cell-status.pending {
  color: #F59E0B;
}

/* 04 底层原理 */
.logic-flow {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx;
  background: rgba(6, 182, 212, 0.06);
  border-radius: 8rpx;
}

.logic-step {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.step-text {
  color: #E2E8F0;
  font-size: 24rpx;
}

.step-arrow {
  color: #06B6D4;
  font-weight: 700;
}

.glossary-box {
  margin-top: 16rpx;
  padding: 14rpx;
  background: rgba(255,255,255,0.03);
  border-radius: 8rpx;
}

.glossary-term {
  font-weight: 700;
  color: #06B6D4;
  display: block;
  margin-bottom: 8rpx;
}

.glossary-explain {
  color: rgba(255,255,255,0.7);
  line-height: 1.5;
}

/* 05 证伪预警 */
.impact-tag {
  font-size: 20rpx;
  color: #EF4444;
  font-family: 'SF Mono', Monaco, monospace;
}

.redline-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.redline-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 14rpx;
  background: rgba(239, 68, 68, 0.08);
  border-left: 3rpx solid #EF4444;
  border-radius: 0 8rpx 8rpx 0;
}

.redline-icon {
  flex-shrink: 0;
}

.redline-text {
  color: #FCA5A5;
  line-height: 1.5;
}

/* 06 最终鉴定 */
.verdict-section .section-body {
  padding: 0;
}

.verdict-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(6, 182, 212, 0.05));
  border: 2rpx solid rgba(139, 92, 246, 0.3);
  border-radius: 12rpx;
}

.verdict-score {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.score-num {
  font-size: 72rpx;
  font-weight: 800;
  color: #A78BFA;
  font-family: 'SF Mono', Monaco, monospace;
}

.score-unit {
  font-size: 28rpx;
  color: rgba(255,255,255,0.5);
}

.verdict-stars {
  display: flex;
  gap: 8rpx;
  margin: 16rpx 0;
}

.star {
  font-size: 32rpx;
  color: rgba(255,255,255,0.2);
}

.star.active {
  color: #FBBF24;
}

.verdict-text {
  text-align: center;
  color: rgba(255,255,255,0.7);
  line-height: 1.6;
  max-width: 90%;
}

/* 07 时间轴 */
.timeline-box {
  position: relative;
  padding-left: 24rpx;
}

.timeline-box::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 8rpx;
  bottom: 8rpx;
  width: 2rpx;
  background: linear-gradient(180deg, #8B5CF6, #06B6D4);
}

.timeline-node {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
  position: relative;
}

.node-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #8B5CF6;
  flex-shrink: 0;
  margin-top: 6rpx;
  position: relative;
  left: -18rpx;
}

.timeline-node.current .node-dot {
  background: #06B6D4;
  box-shadow: 0 0 12rpx #06B6D4;
}

.timeline-node.future .node-dot {
  background: rgba(255,255,255,0.3);
  border: 2rpx dashed rgba(255,255,255,0.5);
}

.node-content {
  flex: 1;
  margin-left: -8rpx;
}

.node-date {
  font-size: 20rpx;
  color: #8B5CF6;
  font-family: 'SF Mono', Monaco, monospace;
  display: block;
  margin-bottom: 4rpx;
}

.timeline-node.current .node-date {
  color: #06B6D4;
}

.node-event {
  color: #E2E8F0;
  line-height: 1.5;
}

/* 底部 */
.bottom-space {
  height: 120rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(15, 23, 42, 0.95);
  border-top: 1rpx solid rgba(255,255,255,0.08);
  backdrop-filter: blur(20rpx);
}

.bar-btn {
  flex: 1;
  padding: 24rpx;
  background: rgba(139, 92, 246, 0.15);
  border: 1rpx solid rgba(139, 92, 246, 0.3);
  border-radius: 12rpx;
  color: #E2E8F0;
  font-size: 26rpx;
  font-weight: 600;
}

.bar-btn:active {
  background: rgba(139, 92, 246, 0.25);
}
