/* 稍后读页面样式 */

page {
  background: linear-gradient(180deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
  min-height: 100vh;
}

.read-later-container {
  min-height: 100vh;
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
}

/* 页面头部 */
.page-header {
  position: relative;
  padding: 40rpx 30rpx 24rpx;
  background: transparent;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(ellipse at 20% 20%, rgba(120, 100, 255, 0.3) 0%, transparent 50%),
              radial-gradient(ellipse at 80% 80%, rgba(255, 100, 200, 0.2) 0%, transparent 50%);
}

.header-content {
  position: relative;
  z-index: 1;
  text-align: center;
  margin-bottom: 24rpx;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 20rpx rgba(120, 100, 255, 0.5);
}

.header-subtitle {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
}

/* 统计卡片 */
.stats-cards {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 工具栏 */
.toolbar {
  padding: 20rpx;
}

.search-box {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 24rpx;
  color: #fff;
}

.toolbar-actions {
  display: flex;
  gap: 12rpx;
}

.tool-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.tool-btn.primary {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-color: rgba(102, 126, 234, 0.5);
}

.btn-icon {
  font-size: 24rpx;
}

.btn-text {
  font-size: 22rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #fff;
}

/* 内容区域 */
.content-area {
  padding: 0 20rpx;
}

/* 批量操作栏 */
.batch-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  padding: 16rpx 20rpx;
  background: rgba(102, 126, 234, 0.9);
  backdrop-filter: blur(20rpx);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.batch-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.batch-count {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
}

.batch-cancel {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  text-decoration: underline;
}

.batch-actions {
  display: flex;
  gap: 12rpx;
}

.batch-btn {
  flex: 1;
  padding: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.batch-btn.danger {
  background: rgba(239, 68, 68, 0.3);
}

.batch-icon {
  font-size: 20rpx;
}

/* 新闻列表 */
.news-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.news-item {
  display: flex;
  gap: 16rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  transition: all 0.3s;
}

.news-item.selected {
  background: rgba(102, 126, 234, 0.2);
  border-color: rgba(102, 126, 234, 0.5);
}

.news-item.read {
  opacity: 0.6;
}

/* 选择框 */
.item-checkbox {
  display: flex;
  align-items: flex-start;
  padding-top: 4rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  transition: all 0.2s;
}

.checkbox.checked {
  background: #667eea;
  border-color: #667eea;
}

/* 内容区 */
.item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.category-badge {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 18rpx;
  font-weight: 500;
}

.category-badge.AI {
  background: rgba(139, 92, 246, 0.2);
  color: #c4b5fd;
}

.category-badge.tech {
  background: rgba(59, 130, 246, 0.2);
  color: #93c5fd;
}

.category-badge.finance {
  background: rgba(245, 158, 11, 0.2);
  color: #fcd34d;
}

.item-time {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.5;
}

.item-summary {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-meta {
  display: flex;
  gap: 16rpx;
}

.meta-item {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}

.item-status {
  display: flex;
}

.status-badge {
  padding: 4rpx 12rpx;
  background: rgba(46, 213, 115, 0.2);
  border-radius: 12rpx;
  font-size: 18rpx;
  color: #2ed573;
}

/* 操作按钮 */
.item-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.action-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #fff;
  transition: all 0.2s;
}

.action-btn:active {
  transform: scale(0.95);
}

.action-btn.danger {
  background: rgba(239, 68, 68, 0.2);
  color: #ef4444;
}

.action-icon {
  font-size: 24rpx;
}

/* 底部操作 */
.bottom-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 32rpx;
  padding: 20rpx 0;
}

.bottom-btn {
  flex: 1;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 排序弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.modal-overlay.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  width: 85%;
  max-width: 600rpx;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  border-radius: 24rpx;
  border: 1rpx solid rgba(102, 126, 234, 0.3);
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: rgba(102, 126, 234, 0.2);
  border-bottom: 1rpx solid rgba(102, 126, 234, 0.2);
}

.modal-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.modal-close {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
}

.modal-body {
  padding: 24rpx;
}

.sort-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  transition: all 0.2s;
}

.sort-option:active {
  background: rgba(255, 255, 255, 0.1);
}

.sort-option.active {
  background: rgba(102, 126, 234, 0.2);
  border: 1rpx solid rgba(102, 126, 234, 0.5);
}

.option-icon {
  font-size: 28rpx;
}

.option-text {
  flex: 1;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.option-check {
  font-size: 24rpx;
  color: #667eea;
}
