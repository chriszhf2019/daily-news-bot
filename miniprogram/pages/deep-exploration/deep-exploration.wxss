/* deep-exploration.wxss - 深度探索（战略智库版）*/

/* 全局 - 极致纯黑背景 */
.research-page {
  min-height: 100vh;
  background: #020617;
  color: #CBD5E1;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 24rpx;
}

/* 加载 */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid rgba(180, 83, 9, 0.2);
  border-top-color: #B45309;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-tip {
  margin-top: 24rpx;
  color: rgba(255,255,255,0.5);
}

/* 空状态 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-tip { color: rgba(255,255,255,0.4); margin-bottom: 32rpx; }
.empty-box .back-btn {
  padding: 20rpx 48rpx;
  background: #B45309;
  color: #fff;
  border-radius: 12rpx;
}

/* 顶部 */
.page-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 32rpx 28rpx 16rpx;
  border-bottom: 1rpx solid rgba(180, 83, 9, 0.15);
}

.top-left { display: flex; flex-direction: column; }

.page-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #FBBF24;
}

.page-subtitle {
  font-size: 18rpx;
  color: #B45309;
  font-weight: 500;
  margin-top: 4rpx;
  font-family: 'SF Mono', Monaco, monospace;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.status-tag {
  font-size: 18rpx;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(255,255,255,0.03);
  color: rgba(255,255,255,0.3);
}

.status-tag.success {
  background: rgba(180, 83, 9, 0.15);
  color: #FBBF24;
}

/* 新闻标题 */
.news-box {
  padding: 16rpx 28rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.03);
}

.news-title {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  line-height: 1.5;
}

/* 展开触发器 */
.expand-trigger {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  margin: 40rpx 28rpx;
  background: linear-gradient(135deg, rgba(180, 83, 9, 0.08), rgba(180, 83, 9, 0.02));
  border: 1rpx dashed rgba(180, 83, 9, 0.3);
  border-radius: 16rpx;
}

.trigger-icon { font-size: 64rpx; margin-bottom: 20rpx; }
.trigger-text { font-size: 28rpx; font-weight: 700; color: #FBBF24; margin-bottom: 8rpx; }
.trigger-hint { font-size: 22rpx; color: rgba(255,255,255,0.4); }

/* 滚动区 */
.content-scroll {
  height: calc(100vh - 220rpx);
  padding: 0 28rpx;
}

/* 模块卡片 */
.section-card {
  margin-top: 24rpx;
  padding: 20rpx;
  background: rgba(255,255,255,0.02);
  border: 1rpx solid rgba(180, 83, 9, 0.1);
  border-radius: 12rpx;
}

.section-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.section-tag {
  font-size: 18rpx;
  color: #B45309;
  font-family: 'SF Mono', Monaco, monospace;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.section-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
}

.empty-text {
  color: rgba(255,255,255,0.2);
  font-size: 22rpx;
  text-align: center;
  padding: 16rpx;
}

/* 20 显微镜核查 */
.micro-section {
  background: rgba(180, 83, 9, 0.08);
  border-color: rgba(180, 83, 9, 0.2);
}

.micro-content {
  font-family: 'SF Mono', Monaco, monospace;
}

.micro-target {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.target-bracket {
  font-size: 24rpx;
  color: rgba(180, 83, 9, 0.5);
}

.target-text {
  font-size: 24rpx;
  color: #FCD34D;
  font-weight: 700;
  text-decoration: underline;
  text-decoration-color: rgba(180, 83, 9, 0.3);
  text-underline-offset: 4rpx;
}

.micro-logic {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  line-height: 1.7;
  font-style: italic;
}

/* 15 推理树 */
.reasoning-tree {
  position: relative;
  padding-left: 24rpx;
  border-left: 2rpx solid rgba(180, 83, 9, 0.3);
  margin-left: 8rpx;
}

.reason-step {
  position: relative;
  padding: 12rpx 0 12rpx 16rpx;
}

.step-dot {
  position: absolute;
  left: -29rpx;
  top: 18rpx;
  width: 12rpx;
  height: 12rpx;
  background: #020617;
  border: 2rpx solid #B45309;
  border-radius: 50%;
}

.step-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  line-height: 1.7;
}

/* 16 历史相似 */
.history-content {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.history-match, .history-lesson {
  padding: 12rpx 14rpx;
  background: rgba(0,0,0,0.2);
  border-radius: 8rpx;
}

.match-label, .lesson-label {
  font-size: 18rpx;
  color: #B45309;
  display: block;
  margin-bottom: 6rpx;
}

.match-text {
  font-size: 24rpx;
  color: #FCD34D;
  font-weight: 500;
}

.lesson-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  line-height: 1.6;
}

/* 17 利益图谱 */
.interests-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.interest-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.03);
}

.interest-row:last-child {
  border-bottom: none;
}

.interest-entity {
  font-size: 22rpx;
  color: #FCD34D;
  font-weight: 600;
  flex-shrink: 0;
  max-width: 35%;
}

.interest-motivation {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
  text-align: right;
  flex: 1;
  margin-left: 16rpx;
}

/* 18 生态位 */
.ecosystem-groups {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.eco-group {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.eco-title {
  font-size: 20rpx;
  color: rgba(255,255,255,0.4);
}

.eco-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.eco-tag {
  padding: 8rpx 14rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-family: 'SF Mono', Monaco, monospace;
}

.eco-tag.upstream {
  background: rgba(180, 83, 9, 0.1);
  border: 1rpx solid rgba(180, 83, 9, 0.2);
  color: #FBBF24;
}

.eco-tag.downstream {
  background: rgba(16, 185, 129, 0.1);
  border: 1rpx solid rgba(16, 185, 129, 0.2);
  color: #34D399;
}

.eco-tag.rival {
  background: rgba(239, 68, 68, 0.1);
  border: 1rpx solid rgba(239, 68, 68, 0.2);
  color: #F87171;
}

/* 19 黑天鹅 */
.blackswan-section {
  background: rgba(239, 68, 68, 0.05);
  border-left: 3rpx solid #DC2626;
  border-radius: 0 12rpx 12rpx 0;
}

.blackswan-content {
  font-size: 22rpx;
  line-height: 1.7;
}

.blackswan-prefix, .blackswan-suffix {
  color: rgba(255,255,255,0.7);
}

.blackswan-trigger {
  color: #F87171;
  font-weight: 700;
}

/* 21 战略终局 */
.outlook-section {
  margin-top: 40rpx;
  padding: 32rpx 20rpx;
  background: transparent;
  border: none;
  text-align: center;
}

.outlook-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(180, 83, 9, 0.3), transparent);
}

.divider-icon {
  font-size: 32rpx;
  color: #B45309;
}

.outlook-head {
  justify-content: center;
  margin-bottom: 20rpx;
}

.outlook-content {
  padding: 0 16rpx;
}

.outlook-quote {
  font-size: 28rpx;
  color: rgba(251, 191, 36, 0.9);
  line-height: 1.8;
  font-family: Georgia, 'Times New Roman', serif;
  font-style: italic;
}

.outlook-footer {
  margin-top: 32rpx;
}

.footer-text {
  font-size: 16rpx;
  color: rgba(255,255,255,0.15);
  font-family: 'SF Mono', Monaco, monospace;
  text-transform: uppercase;
  letter-spacing: 3rpx;
}

/* 底部 */
.bottom-space { height: 120rpx; }

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(2, 6, 23, 0.95);
  border-top: 1rpx solid rgba(180, 83, 9, 0.15);
  backdrop-filter: blur(20rpx);
}

.bar-btn {
  flex: 1;
  padding: 24rpx;
  background: rgba(180, 83, 9, 0.1);
  border: 1rpx solid rgba(180, 83, 9, 0.2);
  border-radius: 12rpx;
  color: #CBD5E1;
  font-size: 26rpx;
  font-weight: 600;
}

.bar-btn.primary {
  background: rgba(180, 83, 9, 0.2);
  border-color: #B45309;
  color: #FBBF24;
}

.bar-btn:active {
  background: rgba(180, 83, 9, 0.3);
  transform: scale(0.98);
}
