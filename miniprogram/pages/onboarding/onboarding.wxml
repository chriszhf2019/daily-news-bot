<!-- 新用户引导页 -->
<view class="onboarding-container">
  <!-- 背景装饰 -->
  <view class="bg-decoration">
    <view class="bg-circle circle-1"></view>
    <view class="bg-circle circle-2"></view>
    <view class="bg-circle circle-3"></view>
  </view>

  <!-- 进度指示器 -->
  <view class="progress-bar">
    <view class="progress-fill" style="width: {{currentStep / totalSteps * 100}}%"></view>
  </view>
  <view class="step-indicator">
    <text class="step-text">{{currentStep}} / {{totalSteps}}</text>
  </view>

  <!-- 步骤1：欢迎页 -->
  <view class="step-content" wx:if="{{currentStep === 1}}">
    <view class="welcome-section">
      <view class="welcome-icon">🎯</view>
      <text class="welcome-title">欢迎来到私人智库</text>
      <text class="welcome-subtitle">AI驱动的深度情报中心</text>
      <view class="welcome-desc">
        <text class="desc-line">📰 每日精选情报，告别信息过载</text>
        <text class="desc-line">🤖 AI深度解读，洞察本质</text>
        <text class="desc-line">🎯 个性化定制，只看你关心的</text>
      </view>
      <view class="welcome-question">
        <text class="question-text">你想如何定义你的情报官？</text>
      </view>
    </view>
  </view>

  <!-- 步骤2：AI人设选择 -->
  <view class="step-content" wx:if="{{currentStep === 2}}">
    <view class="step-header">
      <text class="step-title">选择你的AI情报官风格</text>
      <text class="step-desc">不同风格会影响新闻解读的语气和角度</text>
    </view>
    
    <view class="persona-list">
      <view class="persona-card {{selectedPersona === item.id ? 'selected' : ''}}" 
            wx:for="{{personas}}" wx:key="id"
            bindtap="selectPersona" data-persona="{{item.id}}">
        <view class="persona-icon">{{item.icon}}</view>
        <view class="persona-info">
          <text class="persona-name">{{item.name}}</text>
          <text class="persona-desc">{{item.desc}}</text>
        </view>
        <view class="persona-check" wx:if="{{selectedPersona === item.id}}">✓</view>
      </view>
    </view>
  </view>

  <!-- 步骤3：兴趣标签选择 -->
  <view class="step-content" wx:if="{{currentStep === 3}}">
    <view class="step-header">
      <text class="step-title">选择你的兴趣领域</text>
      <text class="step-desc">我们将优先推送这些领域的情报</text>
    </view>
    
    <view class="tags-actions">
      <text class="action-btn" bindtap="selectAllTags">全选</text>
      <text class="action-divider">|</text>
      <text class="action-btn" bindtap="clearAllTags">清空</text>
      <text class="selected-count">已选 {{selectedTags.length}} 个</text>
    </view>
    
    <scroll-view scroll-y class="tags-scroll">
      <view class="tags-grid">
        <view class="tag-item {{selectedTags.includes(item.id) ? 'selected' : ''}}"
              wx:for="{{interestTags}}" wx:key="id"
              bindtap="toggleTag" data-tag="{{item.id}}">
          <text class="tag-icon">{{item.icon}}</text>
          <text class="tag-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 步骤4：关键词雷达 + AI定制 -->
  <view class="step-content" wx:if="{{currentStep === 4}}">
    <view class="step-header">
      <text class="step-title">设置你的关键词雷达</text>
      <text class="step-desc">输入你最关注的公司、人物或话题</text>
    </view>
    
    <!-- 关键词输入 -->
    <view class="keyword-input-section">
      <view class="keyword-input-wrap">
        <input class="keyword-input" 
               placeholder="输入关键词，如：华为、马斯克"
               value="{{newKeyword}}"
               bindinput="onKeywordInput"
               bindconfirm="addKeyword" />
        <view class="keyword-add-btn" bindtap="addKeyword">添加</view>
      </view>
      
      <!-- 已添加的关键词 -->
      <view class="added-keywords" wx:if="{{radarKeywords.length > 0}}">
        <view class="keyword-chip" wx:for="{{radarKeywords}}" wx:key="*this">
          <text class="chip-text">{{item}}</text>
          <text class="chip-remove" catchtap="removeKeyword" data-keyword="{{item}}">×</text>
        </view>
      </view>
      
      <!-- 推荐关键词 -->
      <view class="suggested-keywords">
        <text class="suggest-label">热门推荐：</text>
        <view class="suggest-list">
          <text class="suggest-chip {{radarKeywords.includes(item) ? 'added' : ''}}" 
                wx:for="{{suggestedKeywords}}" wx:key="*this"
                bindtap="addSuggestedKeyword" data-keyword="{{item}}">
            {{item}} {{radarKeywords.includes(item) ? '✓' : '+'}}
          </text>
        </view>
      </view>
    </view>
    
    <!-- AI定制指令 -->
    <view class="ai-instruction-section">
      <view class="section-header">
        <text class="section-icon">✨</text>
        <text class="section-title">AI定制指令（可选）</text>
      </view>
      <text class="section-desc">用一句话描述你的身份和关注点，AI将为你精准筛选</text>
      <textarea class="ai-instruction-input"
                placeholder="{{aiInstructionPlaceholder}}"
                value="{{aiInstruction}}"
                bindinput="onAiInstructionInput"
                maxlength="200" />
      <text class="char-count">{{aiInstruction.length}}/200</text>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-actions">
    <view class="btn-secondary" bindtap="skipOnboarding" wx:if="{{currentStep === 1}}">
      跳过
    </view>
    <view class="btn-secondary" bindtap="prevStep" wx:if="{{currentStep > 1}}">
      上一步
    </view>
    
    <view class="btn-primary" bindtap="nextStep" wx:if="{{currentStep < totalSteps}}">
      {{currentStep === 1 ? '开始配置' : '下一步'}}
    </view>
    <view class="btn-primary finish" bindtap="finishOnboarding" wx:if="{{currentStep === totalSteps}}">
      🚀 开启私人智库
    </view>
  </view>
</view>
