page { background: #080816; min-height: 100vh; }
.onboarding-container { min-height: 100vh; padding: 60rpx 40rpx; position: relative; overflow: hidden; display: flex; flex-direction: column; }
.bg-decoration { position: absolute; inset: 0; pointer-events: none; }
.bg-circle { position: absolute; border-radius: 50%; opacity: 0.08; }
.circle-1 { width: 500rpx; height: 500rpx; background: radial-gradient(circle, #c4a144, transparent); top: -120rpx; right: -100rpx; }
.circle-2 { width: 400rpx; height: 400rpx; background: radial-gradient(circle, #1e3a5f, transparent); bottom: 100rpx; left: -80rpx; }

.step-dots { display: flex; align-items: center; justify-content: center; gap: 0; margin-bottom: 60rpx; position: relative; z-index: 1; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: rgba(255,255,255,0.12); transition: all 0.3s; }
.dot.active { background: #c4a144; box-shadow: 0 0 16rpx rgba(196,161,68,0.4); }
.dot-line { width: 60rpx; height: 2rpx; background: rgba(255,255,255,0.08); }

.step-content { flex: 1; position: relative; z-index: 1; display: flex; align-items: center; }

/* 欢迎页 */
.welcome-section { width: 100%; display: flex; flex-direction: column; align-items: center; padding-top: 40rpx; }
.welcome-brand { font-size: 72rpx; font-weight: 800; letter-spacing: -2rpx; background: linear-gradient(135deg, #c4a144, #e8c86a); -webkit-background-clip: text; color: transparent; }
.welcome-tagline { font-size: 28rpx; color: rgba(255,255,255,0.4); margin: 12rpx 0 80rpx; letter-spacing: 4rpx; }
.welcome-cards { width: 100%; display: flex; flex-direction: column; gap: 20rpx; }
.feature-card { display: flex; align-items: center; gap: 24rpx; padding: 28rpx 32rpx; background: rgba(255,255,255,0.03); border: 1rpx solid rgba(255,255,255,0.05); border-radius: 20rpx; }
.fc-icon { font-size: 44rpx; }
.fc-title { display: block; font-size: 30rpx; font-weight: 600; color: #e2e8f0; margin-bottom: 6rpx; }
.fc-desc { display: block; font-size: 24rpx; color: rgba(255,255,255,0.4); }

/* 步骤头部 */
.step-header { text-align: center; margin-bottom: 50rpx; width: 100%; }
.step-title { display: block; font-size: 40rpx; font-weight: 700; color: #f1f5f9; margin-bottom: 12rpx; }
.step-desc { display: block; font-size: 26rpx; color: rgba(255,255,255,0.4); }

/* AI风格 */
.persona-list { width: 100%; display: flex; flex-direction: column; gap: 20rpx; }
.persona-card { display: flex; align-items: center; padding: 32rpx; background: rgba(255,255,255,0.04); border: 1.5rpx solid rgba(255,255,255,0.08); border-radius: 20rpx; transition: all 0.25s; }
.persona-card.selected { background: rgba(99,102,241,0.2); border-color: #c4a144; }
.persona-icon { font-size: 52rpx; margin-right: 24rpx; }
.persona-name { display: block; font-size: 32rpx; font-weight: 600; color: #f1f5f9; margin-bottom: 6rpx; }
.persona-desc { display: block; font-size: 24rpx; color: rgba(255,255,255,0.4); }
.persona-check { width: 44rpx; height: 44rpx; background: #c4a144; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 24rpx; font-weight: bold; }

/* 兴趣标签 */
.tags-grid { display: flex; flex-wrap: wrap; gap: 16rpx; width: 100%; }
.tag-item { display: flex; flex-direction: column; align-items: center; width: calc(33.33% - 12rpx); padding: 28rpx 12rpx; background: rgba(255,255,255,0.04); border: 1.5rpx solid rgba(255,255,255,0.08); border-radius: 16rpx; transition: all 0.25s; }
.tag-item.selected { background: rgba(99,102,241,0.2); border-color: #c4a144; }
.tag-icon { font-size: 40rpx; margin-bottom: 10rpx; }
.tag-name { font-size: 24rpx; color: #cbd5e1; font-weight: 500; }

/* 关键词 */
.keyword-input-wrap { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.keyword-input { flex: 1; height: 80rpx; background: rgba(255,255,255,0.1); border: 2rpx solid rgba(255,255,255,0.2); border-radius: 16rpx; padding: 0 24rpx; font-size: 28rpx; color: #fff; }
.keyword-add-btn { height: 80rpx; padding: 0 32rpx; background: linear-gradient(135deg, #c4a144, #8b5cf6); border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #fff; }
.added-keywords { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.keyword-chip { display: flex; align-items: center; gap: 8rpx; padding: 12rpx 20rpx; background: rgba(99,102,241,0.3); border: 1rpx solid rgba(99,102,241,0.5); border-radius: 30rpx; font-size: 26rpx; color: #fff; }
.chip-remove { font-size: 32rpx; color: rgba(255,255,255,0.6); margin-left: 4rpx; }
.suggest-label { font-size: 24rpx; color: rgba(255,255,255,0.5); display: block; margin-bottom: 16rpx; }
.suggest-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.suggest-chip { padding: 10rpx 20rpx; background: rgba(255,255,255,0.08); border: 1rpx solid rgba(255,255,255,0.15); border-radius: 24rpx; font-size: 24rpx; color: rgba(255,255,255,0.8); }
.suggest-chip.added { background: rgba(16,185,129,0.2); border-color: rgba(16,185,129,0.4); color: #10b981; }

/* 底部按钮 */
.bottom-actions { position: fixed; bottom: 0; left: 0; right: 0; z-index: 100; display: flex; gap: 20rpx; padding: 32rpx 40rpx; background: linear-gradient(180deg, transparent, rgba(10,10,26,0.98) 40%); padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.btn-prev { flex: 1; height: 100rpx; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.06); border: 1rpx solid rgba(255,255,255,0.1); border-radius: 24rpx; font-size: 30rpx; color: rgba(255,255,255,0.7); }
.btn-next { flex: 2; height: 100rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #c4a144, #8b5cf6); border-radius: 24rpx; font-size: 32rpx; font-weight: 600; color: #fff; box-shadow: 0 8rpx 32rpx rgba(99,102,241,0.35); }
.btn-next.finish { background: linear-gradient(135deg, #10b981, #059669); box-shadow: 0 8rpx 32rpx rgba(16,185,129,0.35); }
