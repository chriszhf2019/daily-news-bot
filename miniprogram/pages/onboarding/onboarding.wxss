/* 新用户引导页样式 */
page {
  background: linear-gradient(180deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
  min-height: 100vh;
}

.onboarding-container {
  min-height: 100vh;
  padding: 40rpx 30rpx;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  overflow: hidden;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
}

.circle-1 {
  width: 400rpx;
  height: 400rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  top: -100rpx;
  right: -100rpx;
  animation: float 8s ease-in-out infinite;
}

.circle-2 {
  width: 300rpx;
  height: 300rpx;
  background: linear-gradient(135deg, #f093fb, #f5576c);
  bottom: 200rpx;
  left: -80rpx;
  animation: float 10s ease-in-out infinite reverse;
}

.circle-3 {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #4facfe, #00f2fe);
  bottom: -50rpx;
  right: 100rpx;
  animation: float 6s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-30rpx) scale(1.05); }
}

/* 进度条 */
.progress-bar {
  height: 6rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 3rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.step-indicator {
  text-align: right;
  margin-bottom: 40rpx;
}

.step-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 步骤内容 */
.step-content {
  position: relative;
  z-index: 1;
  min-height: 800rpx;
}

/* 欢迎页 */
.welcome-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
}

.welcome-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  animation: bounce 2s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.welcome-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.5);
}

.welcome-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 60rpx;
}

.welcome-desc {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 80rpx;
}

.desc-line {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  padding: 20rpx 30rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
}

.welcome-question {
  margin-top: 40rpx;
}

.question-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fbbf24;
}

/* 步骤头部 */
.step-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.step-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.step-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* AI人设选择 */
.persona-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.persona-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  transition: all 0.3s;
}

.persona-card.selected {
  background: rgba(102, 126, 234, 0.3);
  border-color: #667eea;
  transform: scale(1.02);
}

.persona-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
}

.persona-info {
  flex: 1;
}

.persona-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.persona-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.persona-check {
  width: 48rpx;
  height: 48rpx;
  background: #667eea;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

/* 兴趣标签 */
.tags-actions {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.action-btn {
  font-size: 26rpx;
  color: #667eea;
  padding: 8rpx 16rpx;
}

.action-divider {
  color: rgba(255, 255, 255, 0.3);
  margin: 0 8rpx;
}

.selected-count {
  margin-left: auto;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.tags-scroll {
  height: 600rpx;
}

.tags-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: calc(33.33% - 14rpx);
  padding: 24rpx 16rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  transition: all 0.3s;
}

.tag-item.selected {
  background: rgba(102, 126, 234, 0.3);
  border-color: #667eea;
}

.tag-icon {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.tag-name {
  font-size: 24rpx;
  color: #fff;
  text-align: center;
}

/* 关键词雷达 */
.keyword-input-section {
  margin-bottom: 40rpx;
}

.keyword-input-wrap {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.keyword-input {
  flex: 1;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #fff;
}

.keyword-add-btn {
  height: 80rpx;
  padding: 0 32rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.added-keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.keyword-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(102, 126, 234, 0.3);
  border: 1rpx solid rgba(102, 126, 234, 0.5);
  border-radius: 30rpx;
}

.chip-text {
  font-size: 26rpx;
  color: #fff;
}

.chip-remove {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-left: 4rpx;
}

.suggested-keywords {
  margin-top: 20rpx;
}

.suggest-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 16rpx;
  display: block;
}

.suggest-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.suggest-chip {
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.suggest-chip.added {
  background: rgba(46, 213, 115, 0.2);
  border-color: rgba(46, 213, 115, 0.4);
  color: #2ed573;
}

/* AI定制指令 */
.ai-instruction-section {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.section-icon {
  font-size: 28rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.section-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 16rpx;
}

.ai-instruction-input {
  width: 100%;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
  color: #fff;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 8rpx;
}

/* 底部按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  background: linear-gradient(180deg, transparent, rgba(15, 12, 41, 0.95));
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

.btn-secondary {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 48rpx;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.8);
}

.btn-primary {
  flex: 2;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.4);
}

.btn-primary.finish {
  background: linear-gradient(135deg, #f093fb, #f5576c);
  box-shadow: 0 8rpx 30rpx rgba(240, 147, 251, 0.4);
}
