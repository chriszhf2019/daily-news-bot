/* relevance-analysis.wxss - 私人顾问（决策导向版）*/

/* 全局 - 紫色深靛蓝背景 */
.advisory-page {
  min-height: 100vh;
  background: #1E1B4B;
  color: #E2E8F0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 24rpx;
}

/* 加载 */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid rgba(129, 140, 248, 0.2);
  border-top-color: #818CF8;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-tip {
  margin-top: 24rpx;
  color: rgba(255,255,255,0.6);
}

/* 空状态 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-tip { color: rgba(255,255,255,0.5); margin-bottom: 32rpx; }
.empty-box .back-btn {
  padding: 20rpx 48rpx;
  background: #818CF8;
  color: #fff;
  border-radius: 12rpx;
}

/* 顶部 */
.page-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 32rpx 28rpx 16rpx;
}

.top-left { display: flex; flex-direction: column; }

.page-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
}

.page-subtitle {
  font-size: 20rpx;
  color: #818CF8;
  font-weight: 500;
  margin-top: 4rpx;
}

.status-tag {
  font-size: 18rpx;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(255,255,255,0.05);
  color: rgba(255,255,255,0.4);
}

.status-tag.success {
  background: rgba(16, 185, 129, 0.15);
  color: #10B981;
}

.status-tag.warn {
  background: rgba(245, 158, 11, 0.15);
  color: #F59E0B;
}

/* 身份选择器 */
.persona-nav {
  display: flex;
  gap: 0;
  padding: 0 28rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
  overflow-x: auto;
}

.persona-nav::-webkit-scrollbar { display: none; }

.persona-tab {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.4);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  border-bottom: 3rpx solid transparent;
  transition: all 0.2s;
  white-space: nowrap;
}

.persona-tab.active {
  color: #A5B4FC;
  border-bottom-color: #818CF8;
}

.tab-icon { font-size: 24rpx; }
.tab-name { font-size: 20rpx; }

/* 滚动区 */
.content-scroll {
  height: calc(100vh - 240rpx);
  padding: 0 28rpx;
}

/* 模块卡片 */
.section-card {
  margin-top: 20rpx;
  padding: 20rpx;
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 16rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-tag {
  font-size: 18rpx;
  color: #818CF8;
  font-family: 'SF Mono', Monaco, monospace;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.empty-text {
  color: rgba(255,255,255,0.3);
  font-size: 22rpx;
  text-align: center;
  padding: 20rpx;
}

/* 08 & 09: 量化影响 + 传导 */
.impact-section {
  background: rgba(255,255,255,0.04);
}

.impact-badge {
  font-size: 20rpx;
  font-weight: 700;
  font-family: 'SF Mono', Monaco, monospace;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
}

.impact-badge.positive {
  background: rgba(16, 185, 129, 0.15);
  color: #10B981;
}

.impact-badge.negative {
  background: rgba(244, 63, 94, 0.15);
  color: #F43F5E;
}

.roi-content {
  margin-bottom: 16rpx;
}

.roi-line {
  display: flex;
  gap: 8rpx;
  margin-bottom: 10rpx;
  line-height: 1.6;
}

.roi-label {
  font-size: 22rpx;
  flex-shrink: 0;
}

.roi-line.gain .roi-label { color: #10B981; }
.roi-line.risk .roi-label { color: #F43F5E; }

.roi-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
}

/* 传导路径 */
.flow-path {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx;
  background: rgba(0,0,0,0.25);
  border-radius: 8rpx;
  font-family: 'SF Mono', Monaco, monospace;
  font-size: 20rpx;
}

.path-label {
  color: rgba(255,255,255,0.4);
  margin-right: 4rpx;
}

.path-node {
  color: rgba(255,255,255,0.7);
}

.path-winner {
  color: #10B981;
  font-weight: 600;
  margin-left: 8rpx;
}

/* 11 & 13: 决策 + 避坑 */
.decision-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.decision-side {
  padding: 16rpx;
  border-radius: 12rpx;
}

.decision-side.bull {
  background: rgba(129, 140, 248, 0.1);
  border: 1rpx solid rgba(129, 140, 248, 0.2);
}

.decision-side.bear {
  background: rgba(100, 116, 139, 0.15);
  border: 1rpx solid rgba(255,255,255,0.08);
}

.side-label {
  font-size: 18rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}

.decision-side.bull .side-label { color: #A5B4FC; }
.decision-side.bear .side-label { color: rgba(255,255,255,0.5); }

.side-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  line-height: 1.6;
}

/* 避坑预警 */
.pitfall-box {
  display: flex;
  gap: 12rpx;
  padding: 16rpx;
  background: rgba(245, 158, 11, 0.06);
  border-left: 3rpx solid #F59E0B;
  border-radius: 0 10rpx 10rpx 0;
}

.pitfall-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.pitfall-content {
  flex: 1;
}

.pitfall-label {
  font-size: 18rpx;
  font-weight: 700;
  color: #F59E0B;
  display: block;
  margin-bottom: 6rpx;
}

.pitfall-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  line-height: 1.6;
  font-style: italic;
}

/* 10: 行动协议 */
.action-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.action-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 14rpx 16rpx;
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(255,255,255,0.05);
  border-radius: 10rpx;
  transition: all 0.2s;
}

.action-item:active {
  transform: scale(0.98);
}

.action-item.checked {
  opacity: 0.5;
}

.action-item.checked .action-text {
  text-decoration: line-through;
  color: rgba(255,255,255,0.3);
}

.action-checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid rgba(255,255,255,0.2);
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
  transition: all 0.2s;
}

.action-item.checked .action-checkbox {
  background: #818CF8;
  border-color: #818CF8;
}

.action-checkbox text {
  font-size: 18rpx;
  color: #fff;
  font-weight: 700;
}

.action-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  line-height: 1.5;
}

/* 12 & 14: 时间 + 金句 */
.footer-section {
  background: transparent;
  border: none;
  padding: 16rpx 0;
}

.timing-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
  font-family: 'SF Mono', Monaco, monospace;
  font-size: 20rpx;
}

.timing-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.timing-label {
  color: rgba(255,255,255,0.4);
}

.timing-horizon {
  color: #A5B4FC;
  font-weight: 600;
}

.timing-trigger {
  color: #818CF8;
  text-decoration: underline;
  text-decoration-style: dotted;
  text-underline-offset: 4rpx;
}

/* 金句 */
.gold-quote-box {
  margin-top: 20rpx;
  padding: 20rpx;
  background: linear-gradient(90deg, rgba(129, 140, 248, 0.15), transparent);
  border-left: 3rpx solid #818CF8;
  border-radius: 0 12rpx 12rpx 0;
  position: relative;
}

.quote-text {
  font-size: 24rpx;
  color: #C7D2FE;
  line-height: 1.7;
  font-style: italic;
  display: block;
}

.quote-tag {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  font-size: 16rpx;
  color: rgba(129, 140, 248, 0.6);
  font-family: 'SF Mono', Monaco, monospace;
}

/* 底部 */
.bottom-space { height: 120rpx; }

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(30, 27, 75, 0.95);
  border-top: 1rpx solid rgba(255,255,255,0.06);
  backdrop-filter: blur(20rpx);
}

.bar-btn {
  flex: 1;
  padding: 24rpx;
  background: rgba(129, 140, 248, 0.1);
  border: 1rpx solid rgba(129, 140, 248, 0.2);
  border-radius: 12rpx;
  color: #C7D2FE;
  font-size: 26rpx;
  font-weight: 600;
}

.bar-btn.primary {
  background: rgba(129, 140, 248, 0.2);
  border-color: #818CF8;
}

.bar-btn:active {
  background: rgba(129, 140, 248, 0.3);
  transform: scale(0.98);
}
