/* 极简设计系统 — Ink & Moss */
page {
  --bg: #1a1a1a;
  --surface: #242424;
  --surface-hover: #2a2a2a;
  --text: #f0ede8;
  --text-secondary: rgba(240,237,232,0.55);
  --text-muted: rgba(240,237,232,0.3);
  --accent: #6b8f71;
  --accent-dim: rgba(107,143,113,0.12);
  --divider: rgba(255,255,255,0.06);
  --shadow: 0 2rpx 16rpx rgba(0,0,0,0.3);
  --radius: 16rpx;
  --radius-sm: 10rpx;
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用卡片 */
.card {
  background: var(--surface);
  border-radius: var(--radius);
  padding: var(--space-md);
  box-shadow: var(--shadow);
  transition: transform 0.2s, box-shadow 0.2s;
}
.card:active { transform: scale(0.98); }

/* 通用间距 */
.mt-sm { margin-top: var(--space-sm); }
.mt-md { margin-top: var(--space-md); }
.mt-lg { margin-top: var(--space-lg); }
.mb-md { margin-bottom: var(--space-md); }
.p-md { padding: var(--space-md); }

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: var(--accent-dim);
  color: var(--accent);
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

/* 分割线 */
.divider { height: 1rpx; background: var(--divider); margin: var(--space-md) 0; }

/* 淡入动画 */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.fade-up { animation: fadeUp 0.4s ease both; }

/* 统计数字 */
.stat-num { font-size: 48rpx; font-weight: 700; letter-spacing: -1rpx; }
.stat-label { font-size: 22rpx; color: var(--text-secondary); margin-top: 4rpx; }

/* 页面容器 */
.page-container { padding: var(--space-md); padding-top: 0; }

/* 按钮 */
.btn {
  display: flex; align-items: center; justify-content: center;
  height: 80rpx; border-radius: var(--radius-sm); font-size: 28rpx; font-weight: 600;
  transition: all 0.2s;
}
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:active { opacity: 0.85; transform: scale(0.97); }
.btn-ghost { background: var(--surface); color: var(--text-secondary); border: 1rpx solid var(--divider); }

/* 搜索框 */
.search-input {
  background: var(--surface); border-radius: var(--radius-sm);
  padding: 20rpx var(--space-md); color: var(--text);
  font-size: 28rpx; width: 100%;
}
.search-input::placeholder { color: var(--text-muted); }
