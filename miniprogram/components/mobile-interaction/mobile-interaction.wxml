<!--components/mobile-interaction/mobile-interaction.wxml-->
<view class="mobile-interaction-container" 
      bindtouchstart="touchStart" 
      bindtouchmove="touchMove" 
      bindtouchend="touchEnd"
      bindtap="handleTap"
      bindlongpress="handleLongPress">
  
  <!-- 下拉刷新指示器 -->
  <view wx:if="{{enablePullRefresh}}" class="pull-refresh-container">
    <view class="pull-refresh-indicator" 
          animation="{{pullRefreshAnimation}}"
          wx:if="{{isRefreshing}}">
      <text class="refresh-icon">⟳</text>
      <text class="refresh-text">刷新中...</text>
    </view>
  </view>

  <!-- 悬浮按钮 -->
  <view wx:if="{{enableFloatingButton && showFloatingButton}}" 
        class="floating-button"
        animation="{{floatingButtonAnimation}}"
        bindtap="onFloatingButtonTap">
    <text class="floating-icon">↑</text>
  </view>

  <!-- 页面内容插槽 -->
  <slot></slot>

  <!-- 加载更多指示器 -->
  <view wx:if="{{enableInfiniteScroll}}" class="load-more-container">
    <view class="load-more-indicator" wx:if="{{isLoadingMore}}">
      <text class="load-icon">⟳</text>
      <text class="load-text">加载中...</text>
    </view>
    <view class="load-more-text" wx:else>
      <text>没有更多数据了</text>
    </view>
  </view>

  <!-- 手势提示层 -->
  <view wx:if="{{showGestureHints}}" class="gesture-hints">
    <view class="gesture-hint-item" wx:for="{{gestureHints}}" wx:key="id">
      <text class="hint-icon">{{item.icon}}</text>
      <text class="hint-text">{{item.text}}</text>
    </view>
  </view>
</view>